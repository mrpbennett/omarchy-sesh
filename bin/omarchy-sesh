class ConfigError(ValueError):
    pass


class NamedSessionConflict(ValueError):
    pass


class SnapshotHistoryError(RuntimeError):
    def __init__(self, message, *, retryable=False):
        super().__init__(message)
        self.retryable = retryable


@dataclass(frozen=True)
class SnapshotWindow(Mapping):
    """One selected window keyed by its snapshot-local capture order.

    Mapping access keeps the substantial restore algorithms generic. Their
    internal ``row["id"]`` key resolves to ``ord`` and never to a SQLite key.
    """

    ord: int
    window_class: str
    initial_class: str | None
    title: str | None
    initial_title: str | None
    cmdline: str
    cwd: str | None
    workspace_id: int | None
    workspace_name: str | None
    monitor_name: str | None
    monitor_description: str | None
    at_x: int | None
    at_y: int | None
    size_w: int | None
    size_h: int | None
    floating: int
    fullscreen: int
    pinned: int
    xwayland: int
    pid: int | None
    group_id: int | None
    group_ord: int | None

    _KEYS: ClassVar[tuple[str, ...]] = (
        "id",
        "ord",
        "class",
        "initial_class",
        "title",
        "initial_title",
        "cmdline",
        "cwd",
        "workspace_id",
        "workspace_name",
        "monitor_name",
        "monitor_description",
        "at_x",
        "at_y",
        "size_w",
        "size_h",
        "floating",
        "fullscreen",
        "pinned",
        "xwayland",
        "pid",
        "group_id",
        "group_ord",
    )

    @classmethod
    def from_mapping(cls, value: Mapping[str, object]) -> "SnapshotWindow":
        """Normalize captured or scenario data using snapshot-local ``ord``."""
        if not isinstance(value, Mapping):
            raise TypeError("snapshot window must be a mapping")
        for field in ("ord", "class", "cmdline"):
            if field not in value:
                raise ValueError(f"snapshot window is missing required field {field!r}")
        ord_value = value["ord"]
        if type(ord_value) is not int or ord_value < 0:
            raise ValueError("snapshot window ord must be a non-negative integer")
        window_class = value["class"]
        if not isinstance(window_class, str) or not window_class:
            raise ValueError("snapshot window class must be a non-empty string")
        cmdline = value["cmdline"]
        if not isinstance(cmdline, str) or not cmdline:
            raise ValueError("snapshot window cmdline must be a non-empty string")
        return cls(
            ord=ord_value,
            window_class=window_class,
            initial_class=value.get("initial_class"),
            title=value.get("title"),
            initial_title=value.get("initial_title"),
            cmdline=cmdline,
            cwd=value.get("cwd"),
            workspace_id=value.get("workspace_id"),
            workspace_name=value.get("workspace_name"),
            monitor_name=value.get("monitor_name"),
            monitor_description=value.get("monitor_description"),
            at_x=value.get("at_x"),
            at_y=value.get("at_y"),
            size_w=value.get("size_w"),
            size_h=value.get("size_h"),
            floating=value.get("floating", 0),
            fullscreen=value.get("fullscreen", 0),
            pinned=value.get("pinned", 0),
            xwayland=value.get("xwayland", 0),
            pid=value.get("pid"),
            group_id=value.get("group_id"),
            group_ord=value.get("group_ord"),
        )

    @property
    def identity(self) -> int:
        return self.ord

    def __getitem__(self, key: str) -> object:
        if key == "id":
            return self.identity
        if key == "class":
            return self.window_class
        if key in self._KEYS:
            return getattr(self, key)
        raise KeyError(key)

    def __iter__(self) -> Iterator[str]:
        return iter(self._KEYS)

    def __len__(self) -> int:
        return len(self._KEYS)


@dataclass(frozen=True)
class Snapshot:
    session_id: int
    windows: tuple[SnapshotWindow, ...]
    workspace_layouts: Mapping[int, Mapping[str, object]]
    label: str | None = None
    created_at: str | None = None
    capture_status: str = "complete"
    capture_error: str | None = None

    def __post_init__(self):
        windows = tuple(SnapshotWindow.from_mapping(row) for row in self.windows)
        identities = [window.identity for window in windows]
        if len(identities) != len(set(identities)):
            raise ValueError("snapshot window ord values must be unique")
        object.__setattr__(
            self,
            "windows",
            windows,
        )
        object.__setattr__(
            self,
            "workspace_layouts",
            MappingProxyType(
                {
                    workspace_id: MappingProxyType(dict(layout))
                    for workspace_id, layout in self.workspace_layouts.items()
                }
            ),
        )


@dataclass(frozen=True)
class SnapshotCapture:
    label: str
    status: str
    error: str
    windows: tuple[Mapping[str, object], ...]
    workspace_layouts: tuple[Mapping[str, object], ...]
    name: str | None = None

    def __post_init__(self):
        for field in ("label", "status", "error"):
            value = getattr(self, field)
            if not isinstance(value, str):
                raise TypeError(f"{field} must be a string")
        if self.name is not None and not isinstance(self.name, str):
            raise TypeError("name must be a string or None")
        object.__setattr__(
            self,
            "windows",
            tuple(MappingProxyType(dict(row)) for row in self.windows),
        )
        object.__setattr__(
            self,
            "workspace_layouts",
            tuple(
                MappingProxyType(dict(layout)) for layout in self.workspace_layouts
            ),
        )


@dataclass(frozen=True)
class SnapshotSummary:
    session_id: int
    label: str | None
    created_at: str
    window_count: int
    capture_status: str
    name: str | None = None


@dataclass(frozen=True)
class RestoreSettings:
    timeout_seconds: float
    monitor_fallback: str

    def __post_init__(self):
        if (
            type(self.timeout_seconds) not in (int, float)
            or (
                type(self.timeout_seconds) is float
                and not math.isfinite(self.timeout_seconds)
            )
            or not RESTORE_RETRY_DELAY
            <= self.timeout_seconds
            <= MAX_CONFIG_SECONDS
        ):
            raise ValueError("invalid restore timeout")
        if not isinstance(self.monitor_fallback, str) or (
            self.monitor_fallback not in MONITOR_FALLBACK_POLICIES
            and not MONITOR_CONNECTOR_RE.match(self.monitor_fallback)
        ):
            raise ValueError("invalid monitor fallback")


class ObservationKind(Enum):
    WINDOWS = auto()
    DISPLAYS = auto()
    WORKSPACES = auto()
    WORKSPACE_RULES = auto()
    OUTER_GAPS = auto()
    INNER_GAPS = auto()
    VERSION = auto()
    ANIMATIONS = auto()
    FOCUS = auto()
    FOCUSED_WINDOW = auto()
    FOCUSED_WORKSPACE = auto()
    TREE_REPLAY_SETTINGS = auto()


class ObservationStatus(Enum):
    AVAILABLE = auto()
    UNAVAILABLE = auto()


class MutationStatus(Enum):
    APPLIED = auto()
    UNCHANGED = auto()
    REJECTED = auto()
    UNAVAILABLE = auto()


def _freeze(value):
    if isinstance(value, dict):
        return MappingProxyType({key: _freeze(item) for key, item in value.items()})
    if isinstance(value, (list, tuple)):
        return tuple(_freeze(item) for item in value)
    return value


@dataclass(frozen=True)
class HyprlandCapture:
    windows: tuple
    displays: tuple
    workspaces: tuple
    outer_gaps: object
    inner_gaps: object
    workspace_rules: tuple

    def __post_init__(self):
        for field in ("windows", "displays", "workspaces", "workspace_rules"):
            object.__setattr__(self, field, _freeze(getattr(self, field)))
        object.__setattr__(self, "outer_gaps", _freeze(self.outer_gaps))
        object.__setattr__(self, "inner_gaps", _freeze(self.inner_gaps))


@dataclass(frozen=True)
class CaptureResult:
    status: ObservationStatus
    capture: HyprlandCapture | None = None


@dataclass(frozen=True)
class ObservationResult:
    status: ObservationStatus
    value: object = None

    def __post_init__(self):
        if self.status is ObservationStatus.AVAILABLE:
            if self.value is None:
                raise ValueError("available observation requires a value")
            object.__setattr__(self, "value", _freeze(self.value))
        elif self.value is not None:
            raise ValueError("unavailable observation cannot carry a value")


def _require_text(value, field):
    if not isinstance(value, str) or not value:
        raise ValueError(f"{field} must be a non-empty string")


@dataclass(frozen=True)
class SetAnimations:
    enabled: bool

    def __post_init__(self):
        if type(self.enabled) is not bool:
            raise TypeError("enabled must be a bool")


@dataclass(frozen=True)
class PlaceWindow:
    window: object
    address: str
    current: object | None = None

    def __post_init__(self):
        _require_text(self.address, "address")
        object.__setattr__(self, "window", _freeze(self.window))
        object.__setattr__(self, "current", _freeze(self.current))


@dataclass(frozen=True)
class MoveWindowToWorkspace:
    address: str
    workspace_id: int

    def __post_init__(self):
        _require_text(self.address, "address")


@dataclass(frozen=True)
class MoveWorkspaceToDisplay:
    workspace_id: int
    display: str

    def __post_init__(self):
        _require_text(self.display, "display")


@dataclass(frozen=True)
class LaunchApplication:
    command: str
    workspace_id: int | None
    floating: bool

    def __post_init__(self):
        _require_text(self.command, "command")
        if type(self.floating) is not bool:
            raise TypeError("floating must be a bool")


@dataclass(frozen=True)
class SwapWindows:
    address: str
    target: str

    def __post_init__(self):
        _require_text(self.address, "address")
        _require_text(self.target, "target")


@dataclass(frozen=True)
class ResizeWindow:
    address: str
    width: int
    height: int

    def __post_init__(self):
        _require_text(self.address, "address")


@dataclass(frozen=True)
class FocusWindow:
    address: str

    def __post_init__(self):
        _require_text(self.address, "address")


@dataclass(frozen=True)
class FocusWorkspace:
    workspace_id: int


@dataclass(frozen=True)
class FocusDisplay:
    display: str

    def __post_init__(self):
        _require_text(self.display, "display")


@dataclass(frozen=True)
class ToggleSpecialWorkspace:
    name: str

    def __post_init__(self):
        _require_text(self.name, "name")


@dataclass(frozen=True)
class ReplayWorkspaceTree:
    workspace_id: int
    rows: tuple
    matches: object
    tree: tuple
    focus: object
    stage_id: str

    def __post_init__(self):
        _require_text(self.stage_id, "stage_id")
        for field in ("rows", "matches", "tree", "focus"):
            object.__setattr__(self, field, _freeze(getattr(self, field)))


@dataclass(frozen=True)
class RestoreWindowGroup:
    addresses: tuple

    def __post_init__(self):
        addresses = tuple(self.addresses)
        if not addresses:
            raise ValueError("addresses must not be empty")
        for address in addresses:
            _require_text(address, "address")
        object.__setattr__(self, "addresses", addresses)


@dataclass(frozen=True)
class MutationResult:
    status: MutationStatus

    @property
    def succeeded(self):
        return self.status in (MutationStatus.APPLIED, MutationStatus.UNCHANGED)


@dataclass(frozen=True)
class WorkspaceMoveResult:
    status: MutationStatus
    refreshed_windows: tuple | None = None

    def __post_init__(self):
        if self.status is MutationStatus.APPLIED:
            if self.refreshed_windows is None:
                raise ValueError("applied workspace move requires refreshed windows")
            object.__setattr__(self, "refreshed_windows", _freeze(self.refreshed_windows))
        elif self.refreshed_windows is not None:
            raise ValueError("non-applied workspace move cannot carry refreshed windows")

    @property
    def succeeded(self):
        return self.status in (MutationStatus.APPLIED, MutationStatus.UNCHANGED)


def observed(compositor, kind):
    result = compositor.observe(kind)
    if result.status is ObservationStatus.UNAVAILABLE:
        return None
    return result.value


class ProductionHyprland:
    """Translate semantic desktop operations to Hyprland IPC."""

    def __init__(self, write_log=None):
        self.write_log = write_log

    def _query(self, *args):
        if self.write_log is None:
            return hyprctl_json(*args)
        return hyprctl_json(*args, write_log=self.write_log)

    def capture(self):
        values = (
            self._query("clients"),
            self._query("monitors"),
            self._query("workspaces"),
            self._query("getoption", "general:gaps_out"),
            self._query("getoption", "general:gaps_in"),
            self._query("workspacerules"),
        )
        if any(value is None for value in values):
            return CaptureResult(ObservationStatus.UNAVAILABLE)
        return CaptureResult(
            ObservationStatus.AVAILABLE,
            HyprlandCapture(*values),
        )

    def observe(self, kind):
        if kind is ObservationKind.FOCUS:
            values = (
                self._query("activewindow"),
                self._query("activeworkspace"),
                self._query("monitors"),
            )
            value = None if any(item is None for item in values) else values
        elif kind is ObservationKind.FOCUSED_WINDOW:
            value = self._query("activewindow")
        elif kind is ObservationKind.FOCUSED_WORKSPACE:
            value = self._query("activeworkspace")
        elif kind is ObservationKind.TREE_REPLAY_SETTINGS:
            commands = (
                "getoption dwindle:use_active_for_splits",
                "getoption dwindle:preserve_split",
                "getoption dwindle:permanent_direction_override",
            )
            if self.write_log is None:
                value = hyprctl_batch_json(*commands)
            else:
                value = hyprctl_batch_json(*commands, write_log=self.write_log)
        else:
            endpoint = {
                ObservationKind.WINDOWS: ("clients",),
                ObservationKind.DISPLAYS: ("monitors",),
                ObservationKind.WORKSPACES: ("workspaces",),
                ObservationKind.WORKSPACE_RULES: ("workspacerules",),
                ObservationKind.OUTER_GAPS: ("getoption", "general:gaps_out"),
                ObservationKind.INNER_GAPS: ("getoption", "general:gaps_in"),
                ObservationKind.VERSION: ("version",),
                ObservationKind.ANIMATIONS: ("getoption", "animations:enabled"),
            }[kind]
            value = self._query(*endpoint)
        if value is None:
            return ObservationResult(ObservationStatus.UNAVAILABLE)
        return ObservationResult(ObservationStatus.AVAILABLE, value)

    @contextlib.contextmanager
    def mutations(self):
        previous = animations_enabled(compositor=self)
        suppressed = False
        if previous:
            suppressed = set_animations_enabled(False, compositor=self)
        try:
            yield self
        finally:
            if suppressed and not set_animations_enabled(True, compositor=self):
                (log if self.write_log is None else self.write_log)(
                    "restore: could not re-enable animations; run 'hyprctl reload'"
                )

    def apply(self, action):
        lua, unchanged, failure_context = _production_action(action)
        if unchanged:
            return MutationResult(MutationStatus.UNCHANGED)
        dispatch_action = isinstance(
            action,
            (
                LaunchApplication,
                MoveWindowToWorkspace,
                MoveWorkspaceToDisplay,
                SwapWindows,
                ResizeWindow,
                FocusWindow,
                FocusWorkspace,
                FocusDisplay,
                ToggleSpecialWorkspace,
            ),
        )
        if dispatch_action:
            if self.write_log is None:
                result = (
                    dispatch(lua)
                    if failure_context is None
                    else dispatch(lua, failure_context=failure_context)
                )
            else:
                result = dispatch(
                    lua, failure_context=failure_context, write_log=self.write_log
                )
        else:
            if self.write_log is None:
                result = eval_lua(lua)
            else:
                result = eval_lua(lua, write_log=self.write_log)
        status = (
            MutationStatus.UNAVAILABLE
            if result is None
            else MutationStatus.APPLIED
            if result
            else MutationStatus.REJECTED
        )
        if isinstance(action, MoveWorkspaceToDisplay):
            if status is not MutationStatus.APPLIED:
                return WorkspaceMoveResult(status)
            refreshed = self.observe(ObservationKind.WINDOWS)
            if refreshed.status is ObservationStatus.UNAVAILABLE:
                return WorkspaceMoveResult(MutationStatus.UNAVAILABLE)
            return WorkspaceMoveResult(
                MutationStatus.APPLIED, refreshed.value
            )
        return MutationResult(status)


class DeterministicHyprland:
    """Small stateful Hyprland model for Restore run scenarios."""

    def __init__(
        self,
        *,
        clients=(),
        monitors=(),
        workspaces=(),
        focus=None,
        appearances=(),
        launch_appearances=None,
        window_observations=(),
        observation_results=None,
        action_results=None,
    ):
        self._clients = [dict(client) for client in clients]
        self._monitors = [dict(monitor) for monitor in monitors]
        self._workspaces = [dict(workspace) for workspace in workspaces]
        self._focus = dict(focus or {})
        self._appearances = [tuple(dict(client) for client in batch) for batch in appearances]
        self._launch_appearances = {
            count: tuple(dict(client) for client in batch)
            for count, batch in (launch_appearances or {}).items()
        }
        self._pending_appearances = []
        self._window_observations = list(window_observations)
        self._observation_results = {
            kind: list(queue) for kind, queue in (observation_results or {}).items()
        }
        self._action_results = {
            action_type: list(queue)
            for action_type, queue in (action_results or {}).items()
        }
        self.events = []
        self.animations = True
        self._window_observation_count = 0
        self._successful_launches = 0

    @property
    def windows(self):
        return _freeze(self._clients)

    @property
    def displays(self):
        return _freeze(self._monitors)

    @property
    def workspace_state(self):
        return _freeze(self._workspaces)

    @property
    def focus_state(self):
        return _freeze(self._focus)

    def capture(self):
        self.events.append(("capture",))
        return CaptureResult(
            ObservationStatus.AVAILABLE,
            HyprlandCapture(
                self._clients, self._monitors, self._workspaces, {}, {}, ()
            ),
        )

    def observe(self, kind):
        self.events.append(("observe", kind))
        if kind is ObservationKind.WINDOWS and self._window_observations:
            configured = self._window_observations.pop(0)
        else:
            queue = self._observation_results.get(kind, ())
            configured = queue.pop(0) if queue else None
        if configured is not None:
            if not isinstance(configured, ObservationResult):
                if kind is ObservationKind.WINDOWS:
                    self._clients = [dict(client) for client in configured]
                configured = ObservationResult(
                    ObservationStatus.AVAILABLE, configured
                )
            return configured
        if kind is ObservationKind.WINDOWS:
            if self._window_observation_count and self._appearances:
                self._clients.extend(self._appearances.pop(0))
            if self._pending_appearances:
                self._clients.extend(self._pending_appearances)
                self._pending_appearances = []
            self._window_observation_count += 1
            value = self._clients
        elif kind is ObservationKind.DISPLAYS:
            value = self._monitors
        elif kind is ObservationKind.WORKSPACES:
            value = self._workspaces
        elif kind is ObservationKind.FOCUS:
            value = (
                self._focus.get("window", {}),
                self._focus.get("workspace", {}),
                self._monitors,
            )
        elif kind is ObservationKind.FOCUSED_WINDOW:
            value = self._focus.get("window", {})
        elif kind is ObservationKind.FOCUSED_WORKSPACE:
            value = self._focus.get("workspace", {})
        elif kind is ObservationKind.ANIMATIONS:
            value = {"bool": self.animations}
        elif kind is ObservationKind.VERSION:
            value = {"version": "0.56.0"}
        elif kind is ObservationKind.TREE_REPLAY_SETTINGS:
            value = ({"bool": True}, {"bool": True}, {"bool": False})
        elif kind in (ObservationKind.OUTER_GAPS, ObservationKind.INNER_GAPS):
            value = {"css": "0"}
        else:
            value = ()
        return ObservationResult(ObservationStatus.AVAILABLE, value)

    @contextlib.contextmanager
    def mutations(self):
        self.events.append(("mutations", "begin"))
        previous = self.animations
        self.animations = False
        try:
            yield self
        finally:
            self.animations = previous
            self.events.append(("mutations", "end"))

    def apply(self, action):
        self.events.append(("action", action))
        queue = self._action_results.get(type(action), ())
        configured = queue.pop(0) if queue else None
        if configured is not None:
            status = configured.status if hasattr(configured, "status") else configured
            if status is not MutationStatus.APPLIED:
                if isinstance(action, MoveWorkspaceToDisplay):
                    return WorkspaceMoveResult(status)
                return MutationResult(status)
        if isinstance(action, SetAnimations):
            enabled = action.enabled
            if self.animations == enabled:
                return MutationResult(MutationStatus.UNCHANGED)
            self.animations = enabled
        elif isinstance(action, PlaceWindow):
            client = self._client(action.address)
            if client is None:
                return MutationResult(MutationStatus.REJECTED)
            window = action.window
            if window.get("workspace_id") is not None:
                client["workspace"] = {"id": window["workspace_id"]}
            client["floating"] = bool(window.get("floating"))
            if window.get("floating") and saved_geometry(window) is not None:
                client["at"] = [window["at_x"], window["at_y"]]
                client["size"] = [window["size_w"], window["size_h"]]
            client["fullscreen"] = window.get("fullscreen", 0)
            client["fullscreenClient"] = window.get("fullscreen", 0)
            client["pinned"] = bool(window.get("pinned"))
        elif isinstance(action, MoveWindowToWorkspace):
            client = self._client(action.address)
            if client is None:
                return MutationResult(MutationStatus.REJECTED)
            client["workspace"] = {"id": action.workspace_id}
        elif isinstance(action, MoveWorkspaceToDisplay):
            workspace = next(
                (
                    item
                    for item in self._workspaces
                    if item.get("id") == action.workspace_id
                ),
                None,
            )
            if workspace is None:
                return WorkspaceMoveResult(MutationStatus.REJECTED)
            workspace["monitor"] = action.display
        elif isinstance(action, SwapWindows):
            first = self._client(action.address)
            second = self._client(action.target)
            if first is None or second is None:
                return MutationResult(MutationStatus.REJECTED)
            for field in ("at", "size"):
                first[field], second[field] = second.get(field), first.get(field)
        elif isinstance(action, ResizeWindow):
            client = self._client(action.address)
            if client is None:
                return MutationResult(MutationStatus.REJECTED)
            client["size"] = [action.width, action.height]
        elif isinstance(action, FocusWindow):
            self._focus["window"] = {"address": action.address}
        elif isinstance(action, FocusWorkspace):
            self._focus["workspace"] = {"id": action.workspace_id}
        elif isinstance(action, FocusDisplay):
            for monitor in self._monitors:
                monitor["focused"] = monitor.get("name") == action.display
        elif isinstance(action, ToggleSpecialWorkspace):
            focused = next(
                (monitor for monitor in self._monitors if monitor.get("focused")), None
            )
            if focused is None:
                return MutationResult(MutationStatus.REJECTED)
            focused["specialWorkspace"] = {
                "id": -1,
                "name": "special:" + action.name,
            }
        elif isinstance(action, ReplayWorkspaceTree):
            replay_clients = []
            for row in action.rows:
                address = action.matches.get(row["id"])
                client = self._client(address)
                geometry = saved_geometry(row)
                if client is None or geometry is None:
                    return MutationResult(MutationStatus.REJECTED)
                replay_clients.append((client, geometry))
            for client, geometry in replay_clients:
                client["workspace"] = {"id": action.workspace_id}
                client["at"] = [geometry[0], geometry[1]]
                client["size"] = [geometry[2], geometry[3]]
        elif isinstance(action, RestoreWindowGroup):
            addresses = action.addresses
            if any(self._client(address) is None for address in addresses):
                return MutationResult(MutationStatus.REJECTED)
            for address in addresses:
                self._client(address)["grouped"] = list(addresses)
        elif not isinstance(action, LaunchApplication):
            raise TypeError(f"unsupported Hyprland action: {type(action).__name__}")
        result = MutationResult(MutationStatus.APPLIED)
        if isinstance(action, LaunchApplication) and result.succeeded:
            self._successful_launches += 1
            self._pending_appearances.extend(
                self._launch_appearances.get(self._successful_launches, ())
            )
        if isinstance(action, MoveWorkspaceToDisplay):
            refreshed = self.observe(ObservationKind.WINDOWS)
            if refreshed.status is ObservationStatus.UNAVAILABLE:
                return WorkspaceMoveResult(MutationStatus.UNAVAILABLE)
            return WorkspaceMoveResult(
                MutationStatus.APPLIED, refreshed.value
            )
        return result

    def _client(self, address):
        return next(
            (client for client in self._clients if client.get("address") == address),
            None,
        )


class SystemClockAdapter:
    def monotonic(self):
        return time.monotonic()

    def sleep(self, seconds):
        time.sleep(seconds)


class DeterministicClock:
    def __init__(self, now=0.0):
        self.now = now
        self.events = []

    def monotonic(self):
        self.events.append(("monotonic", self.now))
        return self.now

    def sleep(self, seconds):
        self.events.append(("sleep", seconds))
        self.now += seconds


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    details = path.lstat()
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.geteuid():
        raise OSError(f"refusing unsafe state directory: {path}")
    path.chmod(0o700)


def private_file(path):
    try:
        details = path.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid():
        raise OSError(f"refusing unsafe state file: {path}")
    path.chmod(0o600)


def secure_state_storage():
    private_directory(STATE_DIR)
    private_directory(LOG_PATH.parent)
    for path in (
        DB_PATH,
        DB_PATH.with_name(f"{DB_PATH.name}-wal"),
        DB_PATH.with_name(f"{DB_PATH.name}-shm"),
        DB_PATH.with_name(f"{DB_PATH.name}-journal"),
        LOCK_PATH,
        RESTORE_MARKER_PATH,
        CURRENT_SESSION_PATH,
        LOG_PATH,
        STATE_DIR / "sesh-installed",
        STATE_DIR / "sesh-menu-created",
    ):
        private_file(path)


def session_name(value):
    if not isinstance(value, str) or not value or value != value.strip():
        raise ValueError("must not be empty or have leading/trailing whitespace")
    if len(value) > MAX_SESSION_NAME_LENGTH:
        raise ValueError(f"must be at most {MAX_SESSION_NAME_LENGTH} characters")
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ValueError("must not contain control characters")
    return value


def argparse_session_name(value):
    try:
        return session_name(value)
    except ValueError as e:
        raise argparse.ArgumentTypeError(f"invalid session name: {e}") from e


def log(msg):
    secure_state_storage()
    with open(LOG_PATH, "a") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")


def hyprctl_json(*args, write_log=None):
    write_log = log if write_log is None else write_log
    out = subprocess.run(
        ["hyprctl", "-j", *args], capture_output=True, text=True, check=False
    )
    if out.returncode != 0:
        write_log(f"hyprctl -j {' '.join(args)} failed: {out.stderr.strip()}")
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def hyprctl_batch_json(*commands, write_log=None):
    write_log = log if write_log is None else write_log
    out = subprocess.run(
        ["hyprctl", "-j", "--batch", "; ".join(commands)],
        capture_output=True,
        text=True,
        check=False,
    )
    if out.returncode != 0:
        write_log(f"hyprctl -j --batch failed: {out.stderr.strip()}")
        return None
    decoder = json.JSONDecoder()
    values = []
    position = 0
    while position < len(out.stdout):
        while position < len(out.stdout) and out.stdout[position].isspace():
            position += 1
        if position == len(out.stdout):
            break
        try:
            value, position = decoder.raw_decode(out.stdout, position)
        except json.JSONDecodeError:
            return None
        values.append(value)
    return values if len(values) == len(commands) else None


def dispatch(lua, failure_context=None, *, write_log=None):
    return _dispatch_lua(
        lua, failure_context=failure_context, write_log=write_log
    )


def _dispatch_lua(lua, failure_context=None, *, write_log=None):
    write_log = log if write_log is None else write_log
    out = subprocess.run(
        ["hyprctl", "dispatch", lua], capture_output=True, text=True, check=False
    )
    output = "\n".join(
        part.strip() for part in (out.stdout, out.stderr) if part.strip()
    )
    if out.returncode != 0 or "error" in output.lower():
        if failure_context is not None:
            write_log(
                f"{failure_context}: dispatch failed (request details redacted)"
            )
        else:
            write_log(f"dispatch failed ({lua}): {output}")
        if out.returncode < 0 or 1 <= out.returncode <= 6:
            return None
        return False
    return True


def animations_enabled(*, compositor=None):
    compositor = compositor or ProductionHyprland()
    return _animation_value(observed(compositor, ObservationKind.ANIMATIONS))


def _animation_value(option):
    if not isinstance(option, Mapping):
        return None
    value = option.get("int", option.get("bool"))
    return None if value is None else bool(value)


def set_animations_enabled(enabled, *, compositor=None):
    """Toggle `animations:enabled` through the Lua configuration API.

    `hyprctl keyword` is not usable here: Hyprland 0.56 answers it with
    "keyword can't work with non-legacy parsers. Use eval." and still exits 0,
    so the write must go through `hl.config` and be read back to confirm it
    actually landed.
    """
    compositor = compositor or ProductionHyprland()
    return compositor.apply(SetAnimations(enabled)).succeeded


@contextlib.contextmanager
def animations_disabled(*, compositor=None, write_log=None):
    """Place restored windows without animating each one into position.

    Hyprland animates every move, resize, and workspace change, so an
    otherwise fast restore visibly shuffles windows across the desktop after
    they have already mapped. Suppression is best-effort: when the option
    cannot be read or cleared the restore proceeds with animations on rather
    than failing, and the previous value is always put back.
    """
    compositor = compositor or ProductionHyprland(write_log=write_log)
    with compositor.mutations():
        yield


def eval_lua(lua, *, write_log=None):
    return _eval_lua_result(lua, write_log=write_log)


def _eval_lua_result(lua, *, write_log=None):
    write_log = log if write_log is None else write_log
    out = subprocess.run(
        ["hyprctl", "eval", lua], capture_output=True, text=True, check=False
    )
    output = "\n".join(
        part.strip() for part in (out.stdout, out.stderr) if part.strip()
    )
    if out.returncode != 0 or out.stdout.strip() != "ok":
        write_log(f"eval failed ({lua}): {output}")
        if out.returncode < 0 or 1 <= out.returncode <= 6:
            return None
        return False
    return True


def lua_quote(value):
    value = str(value)
    level = 0
    while f"]{'=' * level}]" in value:
        level += 1
    equals = "=" * level
    return f"[{equals}[{value}]{equals}]"


def acquire_operation_lock(wait=False, wait_timeout=15):
    secure_state_storage()
    lock_file = open(LOCK_PATH, "a+")  # noqa: SIM115 - caller owns lock lifetime
    os.fchmod(lock_file.fileno(), 0o600)
    deadline = time.monotonic() + wait_timeout if wait else None
    while True:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if deadline is None or time.monotonic() >= deadline:
                lock_file.close()
                return None
            time.sleep(0.1)
    return lock_file


def default_config():
    cfg = dict(DEFAULT_CONFIG)
    cfg["exclude_classes"] = list(DEFAULT_CONFIG["exclude_classes"])
    return cfg


def load_config():
    cfg = default_config()
    try:
        content = CONFIG_PATH.read_text(encoding="utf-8")
    except FileNotFoundError:
        return cfg
    except UnicodeError as e:
        raise ConfigError(f"{CONFIG_PATH}: configuration must be UTF-8") from e
    except OSError as e:
        # A file we cannot read says nothing about its contents, so treat it as
        # transient rather than failing an operation the way bad content does.
        log(f"{CONFIG_PATH}: {e.strerror or e}; continuing with default settings")
        return cfg
    try:
        configured = json.loads(content)
    except json.JSONDecodeError as e:
        raise ConfigError(
            f"{CONFIG_PATH}: invalid JSON at line {e.lineno}, column {e.colno}"
        ) from e
    if not isinstance(configured, dict):
        raise ConfigError(f"{CONFIG_PATH}: top-level value must be an object")
    unknown = sorted(set(configured) - set(DEFAULT_CONFIG))
    if unknown:
        raise ConfigError(f"{CONFIG_PATH}: unknown setting {unknown[0]!r}")
    cfg.update(configured)

    excludes = cfg["exclude_classes"]
    if not isinstance(excludes, list) or any(
        not isinstance(value, str) or not value for value in excludes
    ):
        raise ConfigError("exclude_classes must be an array of non-empty strings")
    autosave_seconds = cfg["autosave_seconds"]
    if (
        type(autosave_seconds) is not int
        or autosave_seconds < 1
        or autosave_seconds > MAX_CONFIG_SECONDS
    ):
        raise ConfigError(
            f"autosave_seconds must be an integer from 1 to {MAX_CONFIG_SECONDS}"
        )
    restore_timeout = cfg["restore_timeout_seconds"]
    if (
        type(restore_timeout) not in (int, float)
        or (type(restore_timeout) is float and not math.isfinite(restore_timeout))
        or restore_timeout < RESTORE_RETRY_DELAY
        or restore_timeout > MAX_CONFIG_SECONDS
    ):
        raise ConfigError(
            f"restore_timeout_seconds must be a number from {RESTORE_RETRY_DELAY} "
            f"to {MAX_CONFIG_SECONDS}, so a launch group can retry at least once"
        )
    retention = cfg["snapshot_retention"]
    if (
        type(retention) is not int
        or retention < 1
        or retention > MAX_SNAPSHOT_RETENTION
    ):
        raise ConfigError(
            "snapshot_retention must be an integer from 1 to "
            f"{MAX_SNAPSHOT_RETENTION}"
        )
    monitor_fallback = cfg["monitor_fallback"]
    if not isinstance(monitor_fallback, str) or (
        monitor_fallback not in MONITOR_FALLBACK_POLICIES
        and not MONITOR_CONNECTOR_RE.match(monitor_fallback)
    ):
        raise ConfigError(
            "monitor_fallback must be 'focused', 'lowest', or a monitor connector "
            "such as 'DP-2'"
        )
    return cfg


def load_config_or_defaults(operation):
    """Never let a bad config cost a capture; report it and use the defaults."""
    try:
        return load_config()
    except ConfigError as e:
        log(f"{operation}: {e}; continuing with default settings")
        return default_config()


def migrate_empty_xdg_paths():
    legacy = Path("omarchy")
    if os.environ.get("XDG_CONFIG_HOME") == "":
        source = legacy / "sesh" / "config.json"
        if source.exists() and not CONFIG_PATH.exists():
            CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(source, CONFIG_PATH)
    if os.environ.get("XDG_STATE_HOME") == "":
        secure_state_storage()
        for relative in (
            "session.db",
            "session.db-wal",
            "session.db-shm",
            "session.db-journal",
            "session.lock",
            "restore-complete.json",
            "current-session.json",
            "sesh-installed",
            "sesh-menu-created",
            "log/omarchy-sesh.log",
        ):
            source = legacy / relative
            destination = STATE_DIR / relative
            if source.exists() and not destination.exists():
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(source, destination)
                private_file(destination)
        secure_state_storage()


class SnapshotHistory:
    """Persist and select immutable Snapshots without exposing SQLite."""

    _WINDOW_COLUMNS = (
        "ord",
        "class",
        "initial_class",
        "title",
        "initial_title",
        "cmdline",
        "cwd",
        "workspace_id",
        "workspace_name",
        "monitor_name",
        "monitor_description",
        "at_x",
        "at_y",
        "size_w",
        "size_h",
        "floating",
        "fullscreen",
        "pinned",
        "xwayland",
        "pid",
        "group_id",
        "group_ord",
    )

    def _selected_window(self, values):
        return SnapshotWindow(*values)

    def __init__(self, path=None, *, read_only=False):
        self._path = DB_PATH if path is None else Path(path)
        self._read_only = read_only

    def _connect(self):
        if self._read_only:
            connection = sqlite3.connect(
                f"file:{self._path}?mode=ro", uri=True, timeout=5
            )
            connection.execute("PRAGMA foreign_keys = ON")
            connection.execute("PRAGMA busy_timeout = 5000")
            return connection
        if self._path == DB_PATH:
            secure_state_storage()
        else:
            self._path.parent.mkdir(parents=True, exist_ok=True)
        connection = sqlite3.connect(self._path, timeout=5)
        private_file(self._path)
        connection.execute("PRAGMA journal_mode = WAL")
        if self._path == DB_PATH:
            secure_state_storage()
        connection.execute("PRAGMA foreign_keys = ON")
        connection.execute("PRAGMA busy_timeout = 5000")
        self._migrate(connection)
        return connection

    def _migrate(self, connection):
        try:
            connection.execute("BEGIN IMMEDIATE")
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS sessions (
                    id INTEGER PRIMARY KEY,
                    created_at TEXT NOT NULL DEFAULT (datetime('now')),
                    label TEXT,
                    capture_status TEXT NOT NULL DEFAULT 'complete',
                    capture_error TEXT
                )
                """
            )
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS windows (
                    id INTEGER PRIMARY KEY,
                    session INTEGER NOT NULL,
                    ord INTEGER NOT NULL,
                    class TEXT NOT NULL,
                    initial_class TEXT,
                    title TEXT,
                    initial_title TEXT,
                    cmdline TEXT NOT NULL,
                    cwd TEXT,
                    workspace_id INTEGER,
                    workspace_name TEXT,
                    monitor_name TEXT,
                    monitor_description TEXT,
                    at_x INTEGER, at_y INTEGER,
                    size_w INTEGER, size_h INTEGER,
                    floating INTEGER NOT NULL DEFAULT 0,
                    fullscreen INTEGER NOT NULL DEFAULT 0,
                    pinned INTEGER NOT NULL DEFAULT 0,
                    xwayland INTEGER NOT NULL DEFAULT 0,
                    pid INTEGER,
                    group_id INTEGER,
                    group_ord INTEGER,
                    FOREIGN KEY (session) REFERENCES sessions(id)
                )
                """
            )
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS workspace_layouts (
                    session INTEGER NOT NULL,
                    workspace_id INTEGER NOT NULL,
                    layout TEXT,
                    at_x INTEGER, at_y INTEGER,
                    size_w INTEGER, size_h INTEGER,
                    work_x INTEGER, work_y INTEGER,
                    work_w INTEGER, work_h INTEGER,
                    gap_top INTEGER, gap_right INTEGER,
                    gap_bottom INTEGER, gap_left INTEGER,
                    complete INTEGER NOT NULL DEFAULT 0,
                    PRIMARY KEY (session, workspace_id),
                    FOREIGN KEY (session) REFERENCES sessions(id)
                )
                """
            )
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS named_sessions (
                    name TEXT PRIMARY KEY,
                    session INTEGER NOT NULL UNIQUE,
                    FOREIGN KEY (session) REFERENCES sessions(id)
                )
                """
            )
            session_columns = {
                row[1] for row in connection.execute("PRAGMA table_info(sessions)")
            }
            if "capture_status" not in session_columns:
                connection.execute(
                    "ALTER TABLE sessions ADD COLUMN capture_status "
                    "TEXT NOT NULL DEFAULT 'complete'"
                )
                connection.execute(
                    "UPDATE sessions SET capture_status = 'legacy_unknown' "
                    "WHERE NOT EXISTS (SELECT 1 FROM windows "
                    "WHERE windows.session = sessions.id)"
                )
            if "capture_error" not in session_columns:
                connection.execute("ALTER TABLE sessions ADD COLUMN capture_error TEXT")
            window_columns = {
                row[1] for row in connection.execute("PRAGMA table_info(windows)")
            }
            if "pid" not in window_columns:
                connection.execute("ALTER TABLE windows ADD COLUMN pid INTEGER")
            if "monitor_description" not in window_columns:
                connection.execute(
                    "ALTER TABLE windows ADD COLUMN monitor_description TEXT"
                )
            if "group_id" not in window_columns:
                connection.execute("ALTER TABLE windows ADD COLUMN group_id INTEGER")
            if "group_ord" not in window_columns:
                connection.execute("ALTER TABLE windows ADD COLUMN group_ord INTEGER")
            layout_columns = {
                row[1]
                for row in connection.execute("PRAGMA table_info(workspace_layouts)")
            }
            for column in (
                "work_x",
                "work_y",
                "work_w",
                "work_h",
                "gap_top",
                "gap_right",
                "gap_bottom",
                "gap_left",
            ):
                if column not in layout_columns:
                    connection.execute(
                        f"ALTER TABLE workspace_layouts ADD COLUMN {column} INTEGER"
                    )
            connection.execute("PRAGMA user_version = 6")
            connection.commit()
            if self._path == DB_PATH:
                secure_state_storage()
        except Exception:
            with contextlib.suppress(sqlite3.Error):
                connection.rollback()
            with contextlib.suppress(sqlite3.Error):
                connection.close()
            raise

    def _storage_error(self, error):
        retryable = (
            isinstance(error, sqlite3.OperationalError)
            and any(word in str(error).lower() for word in ("busy", "locked"))
        ) or (
            isinstance(error, OSError)
            and error.errno in (errno.EAGAIN, errno.EBUSY, errno.EINTR)
        )
        return SnapshotHistoryError(
            "snapshot history operation failed", retryable=retryable
        )

    def contains_named(self, name):
        session_name(name)
        try:
            with contextlib.closing(self._connect()) as connection:
                return connection.execute(
                    "SELECT 1 FROM named_sessions WHERE name = ?", (name,)
                ).fetchone() is not None
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error

    def record(self, capture, *, retention):
        if not isinstance(capture, SnapshotCapture):
            raise TypeError("capture must be a SnapshotCapture")
        if capture.name is not None:
            session_name(capture.name)
        try:
            with contextlib.closing(self._connect()) as connection:
                try:
                    connection.execute("BEGIN IMMEDIATE")
                    if capture.name is not None and connection.execute(
                        "SELECT 1 FROM named_sessions WHERE name = ?", (capture.name,)
                    ).fetchone():
                        raise NamedSessionConflict(capture.name)
                    cursor = connection.execute(
                        "INSERT INTO sessions (label, capture_status, capture_error) "
                        "VALUES (?, ?, ?)",
                        (capture.label, capture.status, capture.error or None),
                    )
                    session_id = cursor.lastrowid
                    connection.executemany(
                        "INSERT INTO windows (session, ord, class, initial_class, title, initial_title, "
                        "cmdline, cwd, workspace_id, workspace_name, monitor_name, monitor_description, "
                        "at_x, at_y, size_w, size_h, floating, fullscreen, pinned, xwayland, pid, "
                        "group_id, group_ord) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                        "?, ?, ?, ?, ?, ?, ?, ?)",
                        [
                            (
                                session_id,
                                index,
                                row.get("class"),
                                row.get("initial_class"),
                                row.get("title"),
                                row.get("initial_title"),
                                row.get("cmdline"),
                                row.get("cwd"),
                                row.get("workspace_id"),
                                row.get("workspace_name"),
                                row.get("monitor_name"),
                                row.get("monitor_description"),
                                row.get("at_x"),
                                row.get("at_y"),
                                row.get("size_w"),
                                row.get("size_h"),
                                row.get("floating", 0),
                                row.get("fullscreen", 0),
                                row.get("pinned", 0),
                                row.get("xwayland", 0),
                                row.get("pid"),
                                row.get("group_id"),
                                row.get("group_ord"),
                            )
                            for index, row in enumerate(capture.windows)
                        ],
                    )
                    connection.executemany(
                        "INSERT INTO workspace_layouts (session, workspace_id, layout, at_x, at_y, "
                        "size_w, size_h, work_x, work_y, work_w, work_h, gap_top, gap_right, "
                        "gap_bottom, gap_left, complete) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                        "?, ?, ?, ?, ?)",
                        [
                            (
                                session_id,
                                layout.get("workspace_id"),
                                layout.get("layout"),
                                layout.get("at_x"),
                                layout.get("at_y"),
                                layout.get("size_w"),
                                layout.get("size_h"),
                                layout.get("work_x"),
                                layout.get("work_y"),
                                layout.get("work_w"),
                                layout.get("work_h"),
                                layout.get("gap_top"),
                                layout.get("gap_right"),
                                layout.get("gap_bottom"),
                                layout.get("gap_left"),
                                layout.get("complete", 0),
                            )
                            for layout in capture.workspace_layouts
                        ],
                    )
                    if capture.name is not None and capture.status == "complete":
                        try:
                            connection.execute(
                                "INSERT INTO named_sessions (name, session) VALUES (?, ?)",
                                (capture.name, session_id),
                            )
                        except sqlite3.IntegrityError as error:
                            raise NamedSessionConflict(capture.name) from error
                    keep_ids = {
                        row[0]
                        for row in connection.execute(
                            "SELECT id FROM sessions WHERE capture_status = 'complete' "
                            "AND NOT EXISTS (SELECT 1 FROM named_sessions n WHERE n.session = sessions.id) "
                            "ORDER BY id DESC LIMIT ?",
                            (retention,),
                        )
                    }
                    keep_ids.update(
                        row[0]
                        for row in connection.execute("SELECT session FROM named_sessions")
                    )
                    keep_ids.update(
                        row[0]
                        for row in connection.execute(
                            "SELECT id FROM sessions WHERE capture_status != 'complete' "
                            "ORDER BY id DESC LIMIT ?",
                            (retention,),
                        )
                    )
                    prune_ids = [
                        row[0]
                        for row in connection.execute("SELECT id FROM sessions")
                        if row[0] not in keep_ids
                    ]
                    for stale_id in prune_ids:
                        connection.execute(
                            "DELETE FROM workspace_layouts WHERE session = ?", (stale_id,)
                        )
                        connection.execute(
                            "DELETE FROM windows WHERE session = ?", (stale_id,)
                        )
                    connection.executemany(
                        "DELETE FROM sessions WHERE id = ?",
                        [(stale_id,) for stale_id in prune_ids],
                    )
                    connection.commit()
                except Exception:
                    with contextlib.suppress(sqlite3.Error):
                        connection.rollback()
                    raise
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error
        return session_id

    def select(self, *, name=None, session_id=None):
        if name is not None and session_id is not None:
            raise ValueError("select accepts either name or session_id")
        if name is not None:
            session_name(name)
        try:
            with contextlib.closing(self._connect()) as connection:
                try:
                    connection.execute("BEGIN")
                    if name is not None:
                        row = connection.execute(
                            "SELECT s.id, s.label, s.created_at, s.capture_status, s.capture_error "
                            "FROM named_sessions n JOIN sessions s ON s.id = n.session "
                            "WHERE n.name = ? AND s.capture_status = 'complete'",
                            (name,),
                        ).fetchone()
                    elif session_id is not None:
                        row = connection.execute(
                            "SELECT id, label, created_at, capture_status, capture_error "
                            "FROM sessions WHERE id = ?",
                            (session_id,),
                        ).fetchone()
                    else:
                        row = connection.execute(
                            "SELECT id, label, created_at, capture_status, capture_error "
                            "FROM sessions s WHERE capture_status = 'complete' AND NOT EXISTS "
                            "(SELECT 1 FROM named_sessions n WHERE n.session = s.id) "
                            "ORDER BY s.id DESC LIMIT 1"
                        ).fetchone()
                    if row is None:
                        connection.commit()
                        return None
                    windows_cursor = connection.execute(
                        f"SELECT {', '.join(self._WINDOW_COLUMNS)} FROM windows "
                        "WHERE session = ? ORDER BY ord",
                        (row[0],),
                    )
                    windows = tuple(
                        self._selected_window(window)
                        for window in windows_cursor.fetchall()
                    )
                    layout_cursor = connection.execute(
                        "SELECT workspace_id, layout, at_x, at_y, size_w, size_h, "
                        "work_x, work_y, work_w, work_h, gap_top, gap_right, gap_bottom, "
                        "gap_left, complete FROM workspace_layouts WHERE session = ?",
                        (row[0],),
                    )
                    layout_columns = [column[0] for column in layout_cursor.description]
                    layouts = {
                        layout[0]: dict(zip(layout_columns, layout))
                        for layout in layout_cursor.fetchall()
                    }
                    snapshot = Snapshot(
                        row[0], windows, layouts, row[1], row[2], row[3], row[4]
                    )
                    connection.commit()
                    return snapshot
                except Exception:
                    with contextlib.suppress(sqlite3.Error):
                        connection.rollback()
                    raise
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error

    def list_named(self):
        try:
            with contextlib.closing(self._connect()) as connection:
                rows = connection.execute(
                    "SELECT s.id, s.label, s.created_at, COUNT(w.id), s.capture_status, n.name "
                    "FROM named_sessions n JOIN sessions s ON s.id = n.session "
                    "LEFT JOIN windows w ON w.session = s.id GROUP BY n.name, s.id, s.label, "
                    "s.created_at, s.capture_status ORDER BY n.name COLLATE BINARY"
                ).fetchall()
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error
        return tuple(SnapshotSummary(*row) for row in rows)

    def recent(self, limit=5):
        try:
            with contextlib.closing(self._connect()) as connection:
                rows = connection.execute(
                    "SELECT s.id, s.label, s.created_at, COUNT(w.id), s.capture_status, n.name "
                    "FROM sessions s LEFT JOIN windows w ON w.session = s.id "
                    "LEFT JOIN named_sessions n ON n.session = s.id "
                    "GROUP BY s.id, s.label, s.created_at, s.capture_status, n.name "
                    "ORDER BY s.id DESC LIMIT ?",
                    (limit,),
                ).fetchall()
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error
        return tuple(SnapshotSummary(*row) for row in rows)

    def delete_named(self, name):
        session_name(name)
        try:
            with contextlib.closing(self._connect()) as connection:
                try:
                    connection.execute("BEGIN IMMEDIATE")
                    row = connection.execute(
                        "SELECT s.id, s.label, s.created_at, COUNT(w.id), s.capture_status, n.name "
                        "FROM named_sessions n JOIN sessions s ON s.id = n.session "
                        "LEFT JOIN windows w ON w.session = s.id WHERE n.name = ? "
                        "GROUP BY s.id, s.label, s.created_at, s.capture_status, n.name",
                        (name,),
                    ).fetchone()
                    if row is None:
                        connection.rollback()
                        return None
                    session_id = row[0]
                    connection.execute(
                        "DELETE FROM named_sessions WHERE name = ?", (name,)
                    )
                    connection.execute(
                        "DELETE FROM workspace_layouts WHERE session = ?", (session_id,)
                    )
                    connection.execute(
                        "DELETE FROM windows WHERE session = ?", (session_id,)
                    )
                    connection.execute("DELETE FROM sessions WHERE id = ?", (session_id,))
                    connection.commit()
                    return SnapshotSummary(*row)
                except Exception:
                    with contextlib.suppress(sqlite3.Error):
                        connection.rollback()
                    raise
        except (sqlite3.Error, OSError) as error:
            raise self._storage_error(error) from error


def read_proc(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        if len(argv) == 1 and any(ch.isspace() for ch in argv[0]):
            nested_argv = shlex.split(argv[0])
            if nested_argv and Path(nested_argv[0]).exists():
                argv = nested_argv
        cmdline = shlex.join(argv) if argv else ""
    except (OSError, FileNotFoundError, ValueError):
        return "", "", "cmdline unavailable"
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        cwd = ""
    return cmdline, cwd, "" if cmdline else "empty cmdline"


def cmd_save(label="manual", teardown=False, wait=False, name=None):
    if name is not None:
        session_name(name)
    cfg = load_config_or_defaults(f"save[{label}]")
    lock_file = acquire_operation_lock(wait=wait)
    if lock_file is None:
        log(f"save[{label}]: another session operation is running")
        return 75
    try:
        history = SnapshotHistory()
        if name is not None:
            if history.contains_named(name):
                print(f"save failed: named session {name!r} already exists", file=sys.stderr)
                log(f"save[{label}]: named session {name!r} already exists")
                return 1
        if label == "periodic" and not restore_is_ready():
            log("save[periodic]: startup restore is not complete")
            return 75
        if (
            label == "logout"
            and not teardown
            and not mark_restore_completed(None, complete=False)
        ):
            log("save[logout]: could not close the autosave gate")
            return 75
        captured = ProductionHyprland().capture()
        if captured.status is ObservationStatus.UNAVAILABLE:
            log(f"save[{label}]: capture failed because Hyprland IPC is unavailable")
            print("save failed: Hyprland IPC is unavailable", file=sys.stderr)
            return 75
        capture = captured.capture
        status = "failed" if teardown else "complete"
        errors = ["teardown captures are diagnostic only"] if teardown else []
        return _save_clients(
            label,
            capture.windows,
            capture.displays,
            status,
            errors,
            workspaces=capture.workspaces,
            gaps_out=css_gaps(capture.outer_gaps),
            gaps_in=css_gaps(capture.inner_gaps),
            workspace_rules=capture.workspace_rules,
            cfg=cfg,
            name=name,
        )
    finally:
        lock_file.close()


def assign_snapshot_groups(captured):
    address_counts = {}
    row_by_address = {}
    grouped_by_address = {}
    for row, address, grouped in captured:
        row["group_id"] = None
        row["group_ord"] = None
        if not isinstance(address, str) or not address:
            continue
        address_counts[address] = address_counts.get(address, 0) + 1
        row_by_address[address] = row
        grouped_by_address[address] = grouped

    seen = set()
    group_id = 1
    for _, address, grouped in captured:
        if address in seen or not isinstance(grouped, list) or not grouped:
            continue
        if (
            any(not isinstance(member, str) or not member for member in grouped)
            or len(set(grouped)) != len(grouped)
            or address not in grouped
        ):
            continue
        seen.update(grouped)
        if any(
            address_counts.get(member) != 1
            or grouped_by_address.get(member) != grouped
            for member in grouped
        ):
            continue
        for group_ord, member in enumerate(grouped):
            row_by_address[member]["group_id"] = group_id
            row_by_address[member]["group_ord"] = group_ord
        group_id += 1


def css_gaps(option):
    value = option.get("css") if isinstance(option, Mapping) else None
    if not isinstance(value, str):
        return None
    try:
        values = [round(float(part)) for part in value.split()]
    except ValueError:
        return None
    if len(values) == 1:
        return values * 4
    if len(values) == 2:
        return [values[0], values[1], values[0], values[1]]
    if len(values) == 3:
        return [values[0], values[1], values[2], values[1]]
    return values if len(values) == 4 else None


def monitor_workarea(monitor, gaps_out=None):
    scale = monitor.get("scale")
    reserved = monitor.get("reserved") or []
    if (
        monitor.get("transform", 0) != 0
        or not isinstance(scale, (int, float))
        or scale <= 0
        or len(reserved) < 4
        or any(not isinstance(value, (int, float)) for value in reserved[:4])
    ):
        return None
    left, top, right, bottom = reserved[:4]
    gap_top, gap_right, gap_bottom, gap_left = gaps_out or (0, 0, 0, 0)
    raw_width = monitor.get("width")
    raw_height = monitor.get("height")
    x = monitor.get("x")
    y = monitor.get("y")
    if not all(
        isinstance(value, (int, float))
        for value in (x, y, raw_width, raw_height)
    ):
        return None
    width = round(raw_width / scale)
    height = round(raw_height / scale)
    return (
        round(x + left + gap_left),
        round(y + top + gap_top),
        round(width - left - right - gap_left - gap_right),
        round(height - top - bottom - gap_top - gap_bottom),
    )


def captured_workspace_layouts(
    clients,
    captured,
    monitors,
    workspaces,
    gaps_out=None,
    gaps_in=None,
    workspace_rules=(),
):
    workspace_by_id = {workspace.get("id"): workspace for workspace in workspaces}
    monitor_by_id = {monitor.get("id"): monitor for monitor in monitors}
    client_by_address = {
        client.get("address"): client for client in clients if client.get("address")
    }
    all_tiled = {}
    for client in clients:
        workspace_id = (client.get("workspace") or {}).get("id")
        address = client.get("address")
        if (
            client.get("mapped")
            and not client.get("floating")
            and not client.get("fullscreen")
            and workspace_id is not None
            and address
        ):
            all_tiled.setdefault(workspace_id, set()).add(address)

    captured_by_workspace = {}
    for row, address, _ in captured:
        if (
            not row.get("floating")
            and not row.get("fullscreen")
            and row.get("workspace_id") is not None
            and address
        ):
            captured_by_workspace.setdefault(row["workspace_id"], []).append(
                (row, address)
            )

    layouts = []
    for workspace_id, items in captured_by_workspace.items():
        geometries = [saved_geometry(row) for row, _ in items]
        if len(items) < 2 or any(geometry is None for geometry in geometries):
            continue
        left = min(geometry[0] for geometry in geometries)
        top = min(geometry[1] for geometry in geometries)
        right = max(geometry[0] + geometry[2] for geometry in geometries)
        bottom = max(geometry[1] + geometry[3] for geometry in geometries)
        captured_addresses = {address for _, address in items}
        monitor_ids = {
            client_by_address.get(address, {}).get("monitor") for _, address in items
        }
        workarea = None
        if len(monitor_ids) == 1 and not workspace_rules:
            workarea = monitor_workarea(
                monitor_by_id.get(next(iter(monitor_ids)), {}), gaps_out
            )
        layouts.append(
            {
                "workspace_id": workspace_id,
                "layout": workspace_by_id.get(workspace_id, {}).get("tiledLayout"),
                "at_x": left,
                "at_y": top,
                "size_w": right - left,
                "size_h": bottom - top,
                "work_x": workarea[0] if workarea else None,
                "work_y": workarea[1] if workarea else None,
                "work_w": workarea[2] if workarea else None,
                "work_h": workarea[3] if workarea else None,
                "gap_top": gaps_in[0] if gaps_in else None,
                "gap_right": gaps_in[1] if gaps_in else None,
                "gap_bottom": gaps_in[2] if gaps_in else None,
                "gap_left": gaps_in[3] if gaps_in else None,
                "complete": int(
                    captured_addresses == all_tiled.get(workspace_id, set())
                ),
            }
        )
    return layouts


def _save_clients(
    label,
    clients,
    monitors,
    status,
    errors,
    workspaces=None,
    gaps_out=None,
    gaps_in=None,
    workspace_rules=(),
    cfg=None,
    name=None,
):
    if cfg is None:
        cfg = load_config()
    exclude = DEFAULT_EXCLUDE | set(cfg.get("exclude_classes", []))
    monitor_by_id = {m["id"]: m for m in monitors}
    captured = []
    for w in clients:
        if not w.get("mapped"):
            continue
        cls = w.get("class", "")
        if cls in exclude or not cls:
            continue
        pid = w.get("pid", 0)
        cmdline, cwd, proc_error = read_proc(pid)
        if not cmdline:
            errors.append(f"{w.get('address', cls)}: {proc_error}")
            continue
        ws = w.get("workspace") or {}
        monitor = monitor_by_id.get(w.get("monitor"), {})
        at = w.get("at") or []
        size = w.get("size") or []
        row = {
            "class": cls,
            "initial_class": w.get("initialClass", cls),
            "title": w.get("title", ""),
            "initial_title": w.get("initialTitle", ""),
            "cmdline": cmdline,
            "cwd": cwd,
            "workspace_id": ws.get("id"),
            "workspace_name": ws.get("name"),
            "monitor_name": monitor.get("name"),
            "monitor_description": monitor.get("description"),
            "at_x": at[0] if len(at) > 0 else None,
            "at_y": at[1] if len(at) > 1 else None,
            "size_w": size[0] if len(size) > 0 else None,
            "size_h": size[1] if len(size) > 1 else None,
            "floating": 1 if w.get("floating") else 0,
            "fullscreen": w.get("fullscreen", 0),
            "pinned": 1 if w.get("pinned") else 0,
            "xwayland": 1 if w.get("xwayland") else 0,
            "pid": pid,
        }
        captured.append((row, w.get("address"), w.get("grouped")))
    assign_snapshot_groups(captured)
    rows = [row for row, _, _ in captured]
    workspace_layouts = captured_workspace_layouts(
        clients,
        captured,
        monitors,
        workspaces or (),
        gaps_out,
        gaps_in,
        workspace_rules,
    )
    if errors and status == "complete":
        status = "partial"
    error = "; ".join(errors)
    try:
        sid = SnapshotHistory().record(
            SnapshotCapture(label, status, error, rows, workspace_layouts, name),
            retention=cfg["snapshot_retention"],
        )
    except NamedSessionConflict:
        print(f"save failed: named session {name!r} already exists", file=sys.stderr)
        log(f"save[{label}]: named session {name!r} already exists")
        return 1
    if status == "complete" and (label == "manual" or name is not None):
        mark_restore_completed(sid)
        write_current_session_name(name)
    log(
        f"save[{label}]: {len(rows)} windows -> session {sid} ({status}){': ' + error if error else ''}"
    )
    saved_name = f", name {name!r}" if name is not None and status == "complete" else ""
    print(f"saved {len(rows)} windows (session {sid}, {status}{saved_name})")
    if name is not None and status == "complete":
        print(f"Session saved under {name}")
    if name is not None and status != "complete":
        print(
            f"named session {name!r} was not created because capture is {status}",
            file=sys.stderr,
        )
    return 0 if status == "complete" else 1


def window_classes_match(saved, current):
    if saved == current or {saved, current} <= CHROMIUM_NORMAL_CLASSES:
        return True
    saved_webapp = chromium_webapp_class_base(saved)
    return saved_webapp is not None and saved_webapp == chromium_webapp_class_base(
        current
    )


def client_matches(row, client):
    cls = row["class"]
    initial_cls = row.get("initial_class") or cls
    class_matches = window_classes_match(cls, client.get("class"))
    initial_class_matches = window_classes_match(
        initial_cls, client.get("initialClass")
    )
    if not class_matches and not initial_class_matches:
        return None
    workspace = client.get("workspace") or {}
    workspace_matches = row.get("workspace_id") is None or row.get(
        "workspace_id"
    ) == workspace.get("id")
    title_matches = (
        bool(row.get("title")) and class_matches and row["title"] == client.get("title")
    )
    initial_title_matches = (
        bool(row.get("initial_title"))
        and initial_class_matches
        and row["initial_title"] == client.get("initialTitle")
    )
    if workspace_matches and title_matches:
        return 0
    if workspace_matches and initial_title_matches:
        return 1
    if workspace_matches:
        return 2
    if title_matches or initial_title_matches:
        return 3
    return 4


def client_match_is_unique(row, client, rows):
    rank = client_matches(row, client)
    candidate_ranks = [
        candidate_rank
        for candidate in rows
        if (candidate_rank := client_matches(candidate, client)) is not None
    ]
    return (
        rank is not None
        and rank == min(candidate_ranks)
        and candidate_ranks.count(rank) == 1
    )


def row_match_is_unique(row, client, clients):
    rank = client_matches(row, client)
    candidate_ranks = [
        candidate_rank
        for candidate in clients
        if candidate.get("mapped")
        and candidate.get("address")
        and (candidate_rank := client_matches(row, candidate)) is not None
    ]
    return (
        rank is not None
        and rank == min(candidate_ranks)
        and candidate_ranks.count(rank) == 1
    )


def match_windows(rows, clients, used_addresses=None, max_rank=2):
    excluded = set(used_addresses or ())
    candidates_by_row = {}
    for row in rows:
        candidates_by_row[row["id"]] = []
        for client in clients:
            address = client.get("address")
            if not client.get("mapped") or not address or address in excluded:
                continue
            rank = client_matches(row, client)
            if rank is not None and rank <= max_rank:
                candidates_by_row[row["id"]].append((rank, address))
        candidates_by_row[row["id"]].sort()

    row_ids = [row["id"] for row in sorted(rows, key=lambda row: row["ord"])]
    addresses = sorted(
        {
            address
            for candidates in candidates_by_row.values()
            for _, address in candidates
        }
    )
    rank_base = len(rows) + 1
    address_index = {address: index for index, address in enumerate(addresses)}
    ranked_costs = []
    max_rank_cost = 1
    for row_id in row_ids:
        costs = {}
        for rank, address in candidates_by_row[row_id]:
            cost = 0 if rank == 0 else rank_base ** (rank - 1)
            costs[address_index[address]] = cost
            max_rank_cost = max(max_rank_cost, cost)
        ranked_costs.append(costs)

    # Dummy columns make unmatched rows explicit. Their penalty dominates all
    # real match costs, so assignment maximizes cardinality before match rank.
    unmatched_cost = len(rows) * max_rank_cost + 1
    forbidden_cost = unmatched_cost * (len(rows) + 1)
    column_count = len(addresses) + len(rows)
    costs = []
    for ranked in ranked_costs:
        row_costs = [forbidden_cost] * len(addresses)
        for index, cost in ranked.items():
            row_costs[index] = cost
        row_costs.extend([unmatched_cost] * len(rows))
        costs.append(row_costs)

    # Hungarian assignment for a rectangular matrix (rows <= columns).
    row_potential = [0] * (len(rows) + 1)
    column_potential = [0] * (column_count + 1)
    column_row = [0] * (column_count + 1)
    path = [0] * (column_count + 1)
    for row_number in range(1, len(rows) + 1):
        column_row[0] = row_number
        minimum = [None] * (column_count + 1)
        used = [False] * (column_count + 1)
        column = 0
        while True:
            used[column] = True
            current_row = column_row[column]
            delta = None
            next_column = 0
            for candidate_column in range(1, column_count + 1):
                if used[candidate_column]:
                    continue
                candidate = (
                    costs[current_row - 1][candidate_column - 1]
                    - row_potential[current_row]
                    - column_potential[candidate_column]
                )
                if (
                    minimum[candidate_column] is None
                    or candidate < minimum[candidate_column]
                ):
                    minimum[candidate_column] = candidate
                    path[candidate_column] = column
                if delta is None or minimum[candidate_column] < delta:
                    delta = minimum[candidate_column]
                    next_column = candidate_column
            for candidate_column in range(column_count + 1):
                if used[candidate_column]:
                    row_potential[column_row[candidate_column]] += delta
                    column_potential[candidate_column] -= delta
                elif minimum[candidate_column] is not None:
                    minimum[candidate_column] -= delta
            column = next_column
            if column_row[column] == 0:
                break
        while column:
            previous_column = path[column]
            column_row[column] = column_row[previous_column]
            column = previous_column

    matches = {}
    for column, row_number in enumerate(column_row[1 : len(addresses) + 1]):
        if row_number and column in ranked_costs[row_number - 1]:
            matches[row_ids[row_number - 1]] = addresses[column]
    return matches


def _production_window_placement_operations(w, address, current=None):
    """Lua dispatches that move one matched window to its saved state.

    A property whose live client already matches the snapshot is skipped, so an
    already-correct window costs no compositor round trip and no animation.
    """
    win = lua_quote(f"address:{address}")
    operations = []
    workspace_id = w.get("workspace_id")
    current_workspace = (current or {}).get("workspace") or {}
    workspace_change = workspace_id is not None and (
        current is None or current_workspace.get("id") != workspace_id
    )
    desired_floating = bool(w.get("floating"))
    current_floating = bool(current and current.get("floating"))
    floating_change = current is None or desired_floating != current_floating
    current_geometry = window_geometry(current or {})
    resize_change = (
        desired_floating
        and w.get("size_w") is not None
        and w.get("size_h") is not None
        and (
            current_geometry is None
            or current_geometry[2:] != (w["size_w"], w["size_h"])
        )
    )
    move_change = (
        desired_floating
        and w.get("at_x") is not None
        and w.get("at_y") is not None
        and (
            current_geometry is None
            or current_geometry[:2] != (w["at_x"], w["at_y"])
        )
    )
    disruptive_change = (
        workspace_change or floating_change or resize_change or move_change
    )
    fs = w.get("fullscreen", 0)
    current_internal_fs = None if current is None else current.get("fullscreen", 0)
    current_client_fs = None if current is None else current.get("fullscreenClient", 0)
    current_pinned = bool(current and current.get("pinned"))

    # Pinning and fullscreen can reject or alter workspace/geometry mutations.
    # Temporarily clear them and restore the requested final state afterward.
    effective_pinned = current_pinned
    if current_pinned and disruptive_change:
        operations.append(f"hl.dsp.window.pin({{ window = {win} }})")
        effective_pinned = False
    effective_internal_fs = current_internal_fs
    effective_client_fs = current_client_fs
    if disruptive_change and (
        current is None or current_internal_fs or current_client_fs
    ):
        operations.append(
            f"hl.dsp.window.fullscreen_state({{ internal = 0, client = 0, window = {win} }})"
        )
        effective_internal_fs = 0
        effective_client_fs = 0

    if workspace_change:
        operations.append(
            f"hl.dsp.window.move({{ workspace = {workspace_id}, follow = false, window = {win} }})"
        )
    if floating_change:
        float_action = "on" if desired_floating else "off"
        operations.append(
            f'hl.dsp.window.float({{ action = "{float_action}", window = {win} }})'
        )
    if desired_floating:
        # Resize before moving because Hyprland resize is center-anchored.
        if resize_change:
            operations.append(
                f"hl.dsp.window.resize({{ x = {w['size_w']}, y = {w['size_h']}, window = {win} }})"
            )
        if move_change:
            operations.append(
                f"hl.dsp.window.move({{ x = {w['at_x']}, y = {w['at_y']}, window = {win} }})"
            )
    if effective_internal_fs != fs or effective_client_fs != fs:
        operations.append(
            f"hl.dsp.window.fullscreen_state({{ internal = {fs}, client = {fs}, window = {win} }})"
        )
    if bool(w.get("pinned")) != effective_pinned:
        operations.append(f"hl.dsp.window.pin({{ window = {win} }})")
    return operations


def place_window(w, address, current=None, *, compositor=None):
    if not address:
        return MutationResult(MutationStatus.REJECTED)
    compositor = compositor or ProductionHyprland()
    return compositor.apply(
        PlaceWindow(window=w, address=address, current=current)
    )


def _production_action(action):
    if isinstance(action, SetAnimations):
        enabled = "true" if action.enabled else "false"
        return (
            f"hl.config({{ animations = {{ enabled = {enabled} }} }}) "
            f"if hl.get_config('animations:enabled') ~= {enabled} then "
            "error('animations:enabled did not change') end",
            False,
            None,
        )
    if isinstance(action, PlaceWindow):
        operations = _production_window_placement_operations(
            action.window, action.address, action.current
        )
        script = [
            "local failed=0",
            *(
                f"if not hl.dispatch({operation}).ok then failed=failed+1 end"
                for operation in operations
            ),
            "if failed>0 then error(failed..' placement dispatches failed') end",
        ]
        return " ".join(script), not operations, None
    if isinstance(action, MoveWindowToWorkspace):
        window = lua_quote("address:" + action.address)
        lua = (
            "hl.dsp.window.move({ "
            f"workspace = {action.workspace_id}, follow = false, "
            f"window = {window} "
            "})"
        )
    elif isinstance(action, MoveWorkspaceToDisplay):
        lua = (
            "hl.dsp.workspace.move({ "
            f"workspace = {action.workspace_id}, "
            f"monitor = {lua_quote(action.display)} "
            "})"
        )
    elif isinstance(action, LaunchApplication):
        rules = []
        if action.workspace_id is not None:
            workspace = lua_quote(f"{action.workspace_id} silent")
            rules.append(f"workspace = {workspace}")
        if action.floating:
            rules.append("float = true")
        lua = f"hl.dsp.exec_cmd({lua_quote(action.command)}, {{ {', '.join(rules)} }})"
        return lua, False, "restore: application launch"
    elif isinstance(action, SwapWindows):
        window = lua_quote("address:" + action.address)
        target = lua_quote("address:" + action.target)
        lua = (
            "hl.dsp.window.swap({ "
            f"window = {window}, target = {target} "
            "})"
        )
    elif isinstance(action, ResizeWindow):
        window = lua_quote("address:" + action.address)
        lua = (
            "hl.dsp.window.resize({ "
            f"x = {action.width}, y = {action.height}, "
            f"window = {window} "
            "})"
        )
    elif isinstance(action, FocusWindow):
        window = lua_quote("address:" + action.address)
        lua = f"hl.dsp.focus({{ window = {window} }})"
    elif isinstance(action, FocusWorkspace):
        lua = f"hl.dsp.focus({{ workspace = {action.workspace_id} }})"
    elif isinstance(action, FocusDisplay):
        lua = f"hl.dsp.focus({{ monitor = {lua_quote(action.display)} }})"
    elif isinstance(action, ToggleSpecialWorkspace):
        lua = f"hl.dsp.workspace.toggle_special({lua_quote(action.name)})"
    elif isinstance(action, ReplayWorkspaceTree):
        lua = _production_replay_workspace_tree(action)
    elif isinstance(action, RestoreWindowGroup):
        lua = _production_restore_window_group(action.addresses)
    else:
        raise TypeError(f"unsupported Hyprland action: {type(action).__name__}")
    return lua, False, None


def verify_floating_placements(
    rows, matches, *, compositor=None, clock=None, write_log=None
):
    compositor = compositor or ProductionHyprland()
    clock = clock or SystemClockAdapter()
    write_log = log if write_log is None else write_log
    expected = [
        row
        for row in rows
        if row.get("floating")
        and row.get("id") in matches
        and saved_geometry(row) is not None
    ]
    if not expected:
        return True

    clock.sleep(RESTORE_POLL_INTERVAL)
    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        return None
    current = {client.get("address"): client for client in clients}
    mismatched = []
    for row in expected:
        actual = window_geometry(current.get(matches[row["id"]], {}))
        if actual is None or not geometries_match(saved_geometry(row), actual):
            mismatched.append(row)
    if not mismatched:
        return True

    mutation_ok = True
    for row in mismatched:
        placement = place_window(
            row,
            matches[row["id"]],
            current.get(matches[row["id"]]),
            compositor=compositor,
        )
        if placement.status is MutationStatus.UNAVAILABLE:
            return None
        if not placement.succeeded:
            mutation_ok = False
    clock.sleep(RESTORE_POLL_INTERVAL)
    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        return None
    current = {client.get("address"): client for client in clients}
    failed = []
    for row in mismatched:
        actual = window_geometry(current.get(matches[row["id"]], {}))
        if actual is None or not geometries_match(saved_geometry(row), actual):
            failed.append(row)
    for row in failed:
        write_log(f"restore: floating geometry did not settle for {row['class']}")
    return mutation_ok and not failed


def window_geometry(window):
    at = window.get("at") or []
    size = window.get("size") or []
    if len(at) < 2 or len(size) < 2:
        return None
    return at[0], at[1], size[0], size[1]


def saved_geometry(row):
    values = (
        row.get("at_x"),
        row.get("at_y"),
        row.get("size_w"),
        row.get("size_h"),
    )
    return None if any(value is None for value in values) else values


def monitor_sort_key(monitor):
    monitor_id = monitor.get("id")
    if not isinstance(monitor_id, int):
        monitor_id = sys.maxsize
    return monitor_id, monitor.get("name") or ""


def workspace_monitor_targets(
    rows, monitors, monitor_fallback="focused", *, write_log=None
):
    write_log = log if write_log is None else write_log
    monitors = [monitor for monitor in monitors if monitor.get("name")]
    by_name = {monitor["name"]: monitor for monitor in monitors}
    lowest = min(monitors, key=monitor_sort_key, default=None)
    focused = next(
        (
            monitor
            for monitor in sorted(monitors, key=monitor_sort_key)
            if monitor.get("focused")
        ),
        None,
    )
    if monitor_fallback == "lowest":
        fallback = lowest
    elif monitor_fallback == "focused":
        fallback = focused or lowest
    else:
        fallback = by_name.get(monitor_fallback)
        if fallback is None:
            write_log(
                f"restore: configured fallback monitor {monitor_fallback!r} "
                "is unavailable"
            )
            fallback = focused or lowest
    rows_by_workspace = {}
    for row in rows:
        if row.get("workspace_id") is not None:
            rows_by_workspace.setdefault(row["workspace_id"], []).append(row)

    targets = {}
    for workspace_id, workspace_rows in rows_by_workspace.items():
        saved_names = {
            row.get("monitor_name") for row in workspace_rows if row.get("monitor_name")
        }
        saved_descriptions = {
            row.get("monitor_description")
            for row in workspace_rows
            if row.get("monitor_description")
        }
        if len(saved_names) > 1 or len(saved_descriptions) > 1:
            write_log(
                f"restore: workspace {workspace_id} has conflicting saved monitor identities"
            )
            continue
        saved_name = next(iter(saved_names), None)
        saved_description = next(iter(saved_descriptions), None)
        if saved_name is None and saved_description is None:
            continue

        target = by_name.get(saved_name)
        if saved_description and (
            target is None or target.get("description") != saved_description
        ):
            description_matches = [
                monitor
                for monitor in monitors
                if monitor.get("description") == saved_description
            ]
            if len(description_matches) == 1:
                target = description_matches[0]
            elif target is not None:
                target = None
        if target is None:
            target = fallback
        if target is not None:
            targets[workspace_id] = target["name"]
    return targets


def load_workspace_monitor_context(
    rows, monitor_fallback="focused", *, compositor=None, write_log=None
):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    monitors = observed(compositor, ObservationKind.DISPLAYS)
    workspaces = observed(compositor, ObservationKind.WORKSPACES)
    if monitors is None or workspaces is None or not monitors:
        write_log("restore: Hyprland IPC failed while remapping workspace monitors")
        return {}, {}, True

    current_monitors = {
        workspace.get("id"): workspace.get("monitor") for workspace in workspaces
    }
    return (
        workspace_monitor_targets(
            rows, monitors, monitor_fallback, write_log=write_log
        ),
        current_monitors,
        False,
    )


def prepare_workspace_monitor(
    row, address, targets, current_monitors, prepared, *, compositor=None
):
    compositor = compositor or ProductionHyprland()
    workspace_id = row.get("workspace_id")
    target = targets.get(workspace_id)
    if target is None or workspace_id in prepared:
        return WorkspaceMoveResult(MutationStatus.UNCHANGED)
    if current_monitors.get(workspace_id) == target:
        prepared.add(workspace_id)
        return WorkspaceMoveResult(MutationStatus.UNCHANGED)

    window_move = compositor.apply(
        MoveWindowToWorkspace(address=address, workspace_id=workspace_id)
    )
    if not window_move.succeeded:
        return window_move
    workspace_move = compositor.apply(
        MoveWorkspaceToDisplay(workspace_id=workspace_id, display=target)
    )
    if not workspace_move.succeeded:
        return workspace_move
    current_monitors[workspace_id] = target
    prepared.add(workspace_id)
    return workspace_move


def geometries_match(left, right, tolerance=2):
    return all(abs(a - b) <= tolerance for a, b in zip(left, right))


def geometry_dimensions(geometries):
    left = min(geometry[0] for geometry in geometries)
    top = min(geometry[1] for geometry in geometries)
    right = max(geometry[0] + geometry[2] for geometry in geometries)
    bottom = max(geometry[1] + geometry[3] for geometry in geometries)
    return right - left, bottom - top


def simple_split_order(geometries, tolerance=2):
    if len(geometries) != 2:
        return None
    first, second = geometries
    if (
        abs(first[1] - second[1]) <= tolerance
        and abs(first[3] - second[3]) <= tolerance
    ):
        order = sorted(range(2), key=lambda index: geometries[index][0])
        left, right = (geometries[index] for index in order)
        if left[0] + left[2] <= right[0] + tolerance:
            return "x", order
    if (
        abs(first[0] - second[0]) <= tolerance
        and abs(first[2] - second[2]) <= tolerance
    ):
        order = sorted(range(2), key=lambda index: geometries[index][1])
        top, bottom = (geometries[index] for index in order)
        if top[1] + top[3] <= bottom[1] + tolerance:
            return "y", order
    return None


def geometry_bounds(geometries):
    left = min(geometry[0] for geometry in geometries)
    top = min(geometry[1] for geometry in geometries)
    right = max(geometry[0] + geometry[2] for geometry in geometries)
    bottom = max(geometry[1] + geometry[3] for geometry in geometries)
    return left, top, right - left, bottom - top


def infer_split_tree(items, root_bounds=None, inner_gaps=None, tolerance=2):
    if (
        not items
        or len(items) > 16
        or len({key for key, _ in items}) != len(items)
    ):
        return None
    rectangles = {key: geometry for key, geometry in items}
    gap_top, gap_right, gap_bottom, gap_left = inner_gaps or (0, 0, 0, 0)
    if any(
        geometry is None or geometry[2] <= 0 or geometry[3] <= 0
        for geometry in rectangles.values()
    ):
        return None
    keys = list(rectangles)
    for index, key in enumerate(keys):
        x, y, width, height = rectangles[key]
        for other in keys[index + 1 :]:
            ox, oy, owidth, oheight = rectangles[other]
            if (
                min(x + width, ox + owidth) - max(x, ox) > tolerance
                and min(y + height, oy + oheight) - max(y, oy) > tolerance
            ):
                return None

    root_bounds = root_bounds or geometry_bounds(rectangles.values())
    root_right = root_bounds[0] + root_bounds[2]
    root_bottom = root_bounds[1] + root_bounds[3]
    if root_bounds[2] <= 0 or root_bounds[3] <= 0 or any(
        geometry[0] < root_bounds[0] - tolerance
        or geometry[1] < root_bounds[1] - tolerance
        or geometry[0] + geometry[2] > root_right + tolerance
        or geometry[1] + geometry[3] > root_bottom + tolerance
        for geometry in rectangles.values()
    ):
        return None

    memo = {}

    def infer(subset, node_bounds):
        frozen = frozenset(subset)
        memo_key = (frozen, tuple(round(value, 6) for value in node_bounds))
        if memo_key in memo:
            return memo[memo_key]
        if len(frozen) == 1:
            result = (("leaf", next(iter(frozen))), 1)
            memo[memo_key] = result
            return result

        visible_parent = geometry_bounds([rectangles[key] for key in frozen])
        exemplar = None
        solution_count = 0
        for axis, start_index, size_index in (("x", 0, 2), ("y", 1, 3)):
            other_start = 1 if axis == "x" else 0
            other_size = 3 if axis == "x" else 2
            ordered = sorted(
                frozen,
                key=lambda key: (
                    rectangles[key][start_index],
                    rectangles[key][start_index] + rectangles[key][size_index],
                    str(key),
                ),
            )
            for split_at in range(1, len(ordered)):
                first_keys = ordered[:split_at]
                second_keys = ordered[split_at:]
                first_end = max(
                    rectangles[key][start_index] + rectangles[key][size_index]
                    for key in first_keys
                )
                second_start = min(
                    rectangles[key][start_index] for key in second_keys
                )
                if first_end > second_start + tolerance:
                    continue
                first_box = geometry_bounds(
                    [rectangles[key] for key in first_keys]
                )
                second_box = geometry_bounds(
                    [rectangles[key] for key in second_keys]
                )
                parent_other_start = visible_parent[other_start]
                parent_other_end = parent_other_start + visible_parent[other_size]
                if any(
                    abs(box[other_start] - parent_other_start) > tolerance
                    or abs(
                        box[other_start] + box[other_size] - parent_other_end
                    )
                    > tolerance
                    for box in (first_box, second_box)
                ):
                    continue
                if axis == "x":
                    boundary = (
                        first_end + gap_right + second_start - gap_left
                    ) / 2
                else:
                    boundary = (
                        first_end + gap_bottom + second_start - gap_top
                    ) / 2
                if axis == "x":
                    first_node = (
                        node_bounds[0],
                        node_bounds[1],
                        boundary - node_bounds[0],
                        node_bounds[3],
                    )
                    second_node = (
                        boundary,
                        node_bounds[1],
                        node_bounds[0] + node_bounds[2] - boundary,
                        node_bounds[3],
                    )
                else:
                    first_node = (
                        node_bounds[0],
                        node_bounds[1],
                        node_bounds[2],
                        boundary - node_bounds[1],
                    )
                    second_node = (
                        node_bounds[0],
                        boundary,
                        node_bounds[2],
                        node_bounds[1] + node_bounds[3] - boundary,
                    )
                first_tree, first_count = infer(first_keys, first_node)
                second_tree, second_count = infer(second_keys, second_node)
                if first_count == 0 or second_count == 0:
                    continue
                fraction = first_node[size_index] / node_bounds[size_index]
                if not 0.05 <= fraction <= 0.95:
                    continue
                candidate = (
                    "split",
                    axis,
                    fraction,
                    first_tree,
                    second_tree,
                )
                if exemplar is None:
                    exemplar = candidate
                solution_count = min(
                    2, solution_count + first_count * second_count
                )
                if solution_count == 2:
                    result = (exemplar, 2)
                    memo[memo_key] = result
                    return result
        result = (exemplar, solution_count)
        memo[memo_key] = result
        return result

    tree, count = infer(keys, root_bounds)
    return tree if count == 1 else None


def split_tree_seed(tree):
    while tree[0] == "split":
        tree = tree[3]
    return tree[1]


def nested_replay_supported(*, compositor=None, write_log=None):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    version = observed(compositor, ObservationKind.VERSION)
    if version is None:
        return None
    match = re.match(r"^v?(\d+)\.(\d+)\.(\d+)", str(version.get("version", "")))
    if not match or tuple(map(int, match.groups())) < (0, 56, 0):
        write_log("restore: Hyprland 0.56+ is required for dwindle tree replay")
        return False
    required = {
        "dwindle:use_active_for_splits": True,
        "dwindle:preserve_split": True,
        "dwindle:permanent_direction_override": False,
    }
    values = observed(compositor, ObservationKind.TREE_REPLAY_SETTINGS)
    if values is None:
        return None
    for (option, expected), value in zip(required.items(), values):
        if value.get("bool") is not expected:
            write_log(
                f"restore: dwindle tree replay requires {option} = "
                f"{str(expected).lower()}"
            )
            return False
    return True


def workspace_geometry_matches(
    rows, matches, clients, layout, current_workarea, tolerance=3
):
    client_by_address = {
        client.get("address"): client
        for client in clients
        if client.get("mapped") and client.get("address")
    }
    current = []
    for row in rows:
        client = client_by_address.get(matches.get(row["id"]))
        geometry = window_geometry(client or {})
        if geometry is None:
            return False
        current.append(geometry)
    if not geometries_match(
        current_workarea[2:], (layout["work_w"], layout["work_h"]), tolerance
    ):
        return False
    for row, actual in zip(rows, current):
        desired = saved_geometry(row)
        desired_relative = (
            desired[0] - layout["work_x"],
            desired[1] - layout["work_y"],
            desired[2],
            desired[3],
        )
        actual_relative = (
            actual[0] - current_workarea[0],
            actual[1] - current_workarea[1],
            actual[2],
            actual[3],
        )
        if not geometries_match(desired_relative, actual_relative, tolerance):
            return False
    return True


def replay_workspace_tree(
    workspace_id, rows, matches, tree, focus_context, *, compositor=None
):
    compositor = compositor or ProductionHyprland()
    addresses = [matches[row["id"]] for row in rows]
    result = compositor.apply(
        ReplayWorkspaceTree(
            workspace_id=workspace_id,
            rows=rows,
            matches=matches,
            tree=tree,
            focus=focus_context,
            stage_id=f"omarchy-sesh-stage-{os.getpid()}-{workspace_id}",
        )
    )
    if result.status is MutationStatus.UNAVAILABLE:
        return None, addresses
    return result.succeeded, addresses


def _production_replay_workspace_tree(action):
    workspace_id = action.workspace_id
    rows = action.rows
    matches = action.matches
    tree = action.tree
    focus_context = action.focus
    variable_by_id = {
        row["id"]: f"w{index}" for index, row in enumerate(rows, start=1)
    }
    declarations = [
        f"local {variable_by_id[row['id']]}=assert(hl.get_window({lua_quote(f'address:{matches[row['id']]}')}), 'replay member missing')"
        for row in rows
    ]
    operations = []
    staging = lua_quote("name:" + action.stage_id)
    seed_id = split_tree_seed(tree)
    for row in rows:
        if row["id"] == seed_id:
            continue
        operations.append(
            "run(hl.dispatch(hl.dsp.window.move({ "
            f"workspace = {staging}, follow = false, window = {lua_quote(f'address:{matches[row['id']]}')} "
            "})))"
        )

    def expand(node):
        if node[0] == "leaf":
            return
        _, axis, fraction, first, second = node
        first_id = split_tree_seed(first)
        second_id = split_tree_seed(second)
        first_selector = lua_quote(f"address:{matches[first_id]}")
        second_selector = lua_quote(f"address:{matches[second_id]}")
        direction = "right" if axis == "x" else "down"
        operations.extend(
            (
                f"run(hl.dispatch(hl.dsp.focus({{ window = {first_selector} }})))",
                f"run(hl.dispatch(hl.dsp.layout({lua_quote(f'preselect {direction}')})))",
                (
                    "run(hl.dispatch(hl.dsp.window.move({ "
                    f"workspace = {workspace_id}, follow = false, "
                    f"window = {second_selector} "
                    "})))"
                ),
                f"run(hl.dispatch(hl.dsp.focus({{ window = {first_selector} }})))",
                f"run(hl.dispatch(hl.dsp.layout({lua_quote(f'splitratio {2 * fraction:.12g} exact')})))",
            )
        )
        expand(first)
        expand(second)

    expand(tree)
    focus_action = None
    if focus_context.get("address"):
        focus_action = (
            "hl.dispatch(hl.dsp.focus({ "
            f"window = {lua_quote(f'address:{focus_context['address']}')} "
            "}))"
        )
    elif (
        not focus_context.get("special_workspace")
        and focus_context.get("workspace_id") is not None
    ):
        focus_action = (
            "hl.dispatch(hl.dsp.focus({ "
            f"workspace = {focus_context['workspace_id']} "
            "}))"
        )
    script = [
        *declarations,
        "local function run(result) assert(result.ok, result.error or 'dispatch failed') end",
        f"local ok,err=pcall(function() {' '.join(operations)} end)",
    ]
    if focus_action:
        script.append(f"local focus={focus_action}")
    script.append("if not ok then error(err) end")
    return " ".join(script)


def load_focus_context(*, compositor=None):
    compositor = compositor or ProductionHyprland()
    focus = observed(compositor, ObservationKind.FOCUS)
    if focus is None:
        return None
    active_window, active_workspace, monitors = focus
    focused_monitor = next(
        (monitor for monitor in monitors if monitor.get("focused")), {}
    )
    special = focused_monitor.get("specialWorkspace") or {}
    return {
        "address": active_window.get("address"),
        "workspace_id": active_workspace.get("id"),
        "monitor_name": focused_monitor.get("name"),
        "special_workspace": special.get("name") if special.get("id") else None,
    }


def restore_focus_context(context, *, compositor=None):
    compositor = compositor or ProductionHyprland()
    if not context:
        return True
    address = context.get("address")
    workspace_id = context.get("workspace_id")
    special_workspace = context.get("special_workspace")
    if address:
        dispatched = compositor.apply(FocusWindow(address=address))
        current = observed(compositor, ObservationKind.FOCUSED_WINDOW)
        if current is None:
            return None
        if dispatched.succeeded and current.get("address") == address:
            return True
        if special_workspace:
            return restore_focus_context(
                dict(context, address=None), compositor=compositor
            )
        if workspace_id is None:
            return False
        action = FocusWorkspace(workspace_id=workspace_id)
        expected = workspace_id
        observation_kind = ObservationKind.FOCUSED_WORKSPACE
    elif special_workspace:
        monitors = observed(compositor, ObservationKind.DISPLAYS)
        if monitors is None:
            return None
        monitor_name = context.get("monitor_name")
        expected_special = (
            special_workspace
            if special_workspace.startswith("special:")
            else f"special:{special_workspace}"
        )

        def special_is_focused(current_monitors):
            return any(
                monitor.get("name") == monitor_name
                and monitor.get("focused")
                and (monitor.get("specialWorkspace") or {}).get("name")
                == expected_special
                for monitor in current_monitors
            )

        if special_is_focused(monitors):
            return True
        if not monitor_name:
            return False
        dispatched = compositor.apply(FocusDisplay(display=monitor_name))
        if not dispatched.succeeded:
            return None if dispatched.status is MutationStatus.UNAVAILABLE else False
        monitors = observed(compositor, ObservationKind.DISPLAYS)
        if monitors is None:
            return None
        if not any(
            monitor.get("name") == monitor_name
            and (monitor.get("specialWorkspace") or {}).get("name")
            == expected_special
            for monitor in monitors
        ):
            toggle_name = special_workspace.removeprefix("special:")
            toggled = compositor.apply(
                ToggleSpecialWorkspace(name=toggle_name)
            )
            if not toggled.succeeded:
                return None if toggled.status is MutationStatus.UNAVAILABLE else False
            monitors = observed(compositor, ObservationKind.DISPLAYS)
            if monitors is None:
                return None
        return special_is_focused(monitors)
    elif workspace_id is not None:
        action = FocusWorkspace(workspace_id=workspace_id)
        expected = workspace_id
        observation_kind = ObservationKind.FOCUSED_WORKSPACE
    else:
        return True
    dispatched = compositor.apply(action)
    current = observed(compositor, observation_kind)
    if current is None:
        return None
    return dispatched.succeeded and current.get("id") == expected


def recover_replay_workspace(
    workspace_id, addresses, focus_context, *, compositor=None
):
    compositor = compositor or ProductionHyprland()
    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        return None
    workspace_by_address = {
        client.get("address"): (client.get("workspace") or {}).get("id")
        for client in clients
    }
    for address in addresses:
        if workspace_by_address.get(address) != workspace_id:
            moved = compositor.apply(
                MoveWindowToWorkspace(address=address, workspace_id=workspace_id)
            )
            if not moved.succeeded:
                return None if moved.status is MutationStatus.UNAVAILABLE else False
    return restore_focus_context(focus_context, compositor=compositor)


def restore_nested_tiled_layouts(
    rows,
    matches,
    clients,
    layouts,
    focus_context=None,
    *,
    compositor=None,
    write_log=None,
):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    rows_by_workspace = {}
    for row in rows:
        if not row.get("floating") and row.get("workspace_id") is not None:
            rows_by_workspace.setdefault(row["workspace_id"], []).append(row)

    if not any(
        len(workspace_rows) >= 2 and layouts.get(workspace_id)
        for workspace_id, workspace_rows in rows_by_workspace.items()
    ):
        return True
    workspace_rules = observed(compositor, ObservationKind.WORKSPACE_RULES)
    if workspace_rules is None:
        return None
    if workspace_rules:
        write_log("restore: workspace-specific rules disable dwindle tree replay")
        return True
    live_workspaces = observed(compositor, ObservationKind.WORKSPACES)
    live_monitors = observed(compositor, ObservationKind.DISPLAYS)
    gaps_out = observed(compositor, ObservationKind.OUTER_GAPS)
    gaps_in = observed(compositor, ObservationKind.INNER_GAPS)
    if any(value is None for value in (live_workspaces, live_monitors, gaps_out, gaps_in)):
        return None
    gaps_out = css_gaps(gaps_out)
    gaps_in = css_gaps(gaps_in)
    if gaps_out is None or gaps_in is None:
        return True
    live_workspace_by_id = {
        workspace.get("id"): workspace for workspace in live_workspaces
    }
    live_monitor_by_name = {
        monitor.get("name"): monitor for monitor in live_monitors
    }

    candidates = []
    for workspace_id, workspace_rows in rows_by_workspace.items():
        layout = layouts.get(workspace_id)
        if len(workspace_rows) < 2 or not layout:
            continue
        if (
            layout.get("layout") != "dwindle"
            or not layout.get("complete")
            or any(
                layout.get(field) is None
                for field in (
                    "work_x",
                    "work_y",
                    "work_w",
                    "work_h",
                    "gap_top",
                    "gap_right",
                    "gap_bottom",
                    "gap_left",
                )
            )
            or any(
                row.get("fullscreen")
                or row.get("pinned")
                or row.get("group_id") is not None
                for row in workspace_rows
            )
        ):
            continue
        live_workspace = live_workspace_by_id.get(workspace_id, {})
        if live_workspace.get("tiledLayout") != "dwindle":
            continue
        current_workarea = monitor_workarea(
            live_monitor_by_name.get(live_workspace.get("monitor"), {}),
            gaps_out,
        )
        if current_workarea is None or not geometries_match(
            current_workarea[2:], (layout["work_w"], layout["work_h"])
        ):
            continue
        saved_gaps_in = (
            layout["gap_top"],
            layout["gap_right"],
            layout["gap_bottom"],
            layout["gap_left"],
        )
        if tuple(gaps_in) != saved_gaps_in:
            continue
        workspace_rows.sort(key=lambda row: row["ord"])
        tree = infer_split_tree(
            [(row["id"], saved_geometry(row)) for row in workspace_rows],
            (
                layout["work_x"],
                layout["work_y"],
                layout["work_w"],
                layout["work_h"],
            ),
            saved_gaps_in,
        )
        if tree is None:
            write_log(
                f"restore: workspace {workspace_id} has ambiguous tiled geometry"
            )
            continue
        saved_bounds = geometry_bounds(
            [saved_geometry(row) for row in workspace_rows]
        )
        if not geometries_match(
            saved_bounds,
            (
                layout.get("at_x"),
                layout.get("at_y"),
                layout.get("size_w"),
                layout.get("size_h"),
            ),
        ):
            continue
        context = tiled_workspace_clients(
            workspace_id, workspace_rows, matches, clients
        )
        if context is None:
            continue
        current, client_by_address = context
        if any(
            bool(client.get("grouped"))
            or client.get("pinned")
            for client in current
        ) or any(
            not row_match_is_unique(row, client_by_address[matches[row["id"]]], clients)
            for row in workspace_rows
        ):
            continue
        if not geometries_match(
            geometry_dimensions([window_geometry(client) for client in current]),
            (layout["size_w"], layout["size_h"]),
        ):
            continue
        if workspace_geometry_matches(
            workspace_rows, matches, clients, layout, current_workarea
        ):
            continue
        candidates.append(
            (workspace_id, workspace_rows, layout, current_workarea, tree)
        )

    if not candidates:
        return True
    supported = nested_replay_supported(
        compositor=compositor, write_log=write_log
    )
    if supported is None:
        return None
    if not supported:
        return True
    restore_loaded_focus = focus_context is None
    focus_context = focus_context or load_focus_context(compositor=compositor)
    if focus_context is None:
        return None

    for workspace_id, workspace_rows, layout, current_workarea, tree in candidates:
        result, addresses = replay_workspace_tree(
            workspace_id,
            workspace_rows,
            matches,
            tree,
            focus_context,
            compositor=compositor,
        )
        if result is None:
            recover_replay_workspace(
                workspace_id, addresses, focus_context, compositor=compositor
            )
            return None
        refreshed = observed(compositor, ObservationKind.WINDOWS)
        if refreshed is None:
            recover_replay_workspace(
                workspace_id, addresses, focus_context, compositor=compositor
            )
            return None
        if not result or not workspace_geometry_matches(
            workspace_rows, matches, refreshed, layout, current_workarea
        ):
            write_log(
                f"restore: tiled replay verification failed on workspace {workspace_id}"
            )
            recovery = recover_replay_workspace(
                workspace_id, addresses, focus_context, compositor=compositor
            )
            return None if recovery is None else False
        if restore_loaded_focus:
            focus_result = restore_focus_context(
                focus_context, compositor=compositor
            )
            if focus_result is None:
                return None
            if not focus_result:
                return False
        clients = refreshed
    return True


def tiled_workspace_clients(workspace_id, rows, matches, clients):
    if len(rows) < 2 or any(saved_geometry(row) is None for row in rows):
        return None
    if any(row.get("fullscreen") or row["id"] not in matches for row in rows):
        return None

    current = [
        client
        for client in clients
        if client.get("mapped")
        and not client.get("floating")
        and (client.get("workspace") or {}).get("id") == workspace_id
    ]
    if len(current) != len(rows) or any(
        client.get("fullscreen") or window_geometry(client) is None
        for client in current
    ):
        return None

    matched_addresses = {matches[row["id"]] for row in rows}
    current_addresses = {client.get("address") for client in current}
    if None in current_addresses or matched_addresses != current_addresses:
        return None

    client_by_address = {client["address"]: client for client in current}
    for row in rows:
        client = client_by_address[matches[row["id"]]]
        if not client_match_is_unique(row, client, rows):
            return None
    return current, client_by_address


def tiled_slot_addresses(rows, current):
    slots = []
    for row in rows:
        candidates = [
            client["address"]
            for client in current
            if geometries_match(saved_geometry(row), window_geometry(client))
        ]
        if len(candidates) != 1:
            return None
        slots.append(candidates[0])
    return slots if len(set(slots)) == len(rows) else None


def two_window_geometry_matches(rows, matches, current):
    saved = [saved_geometry(row) for row in rows]
    actual = [window_geometry(client) for client in current]
    saved_split = simple_split_order(saved)
    actual_split = simple_split_order(actual)
    if (
        saved_split is None
        or actual_split is None
        or saved_split[0] != actual_split[0]
        or not geometries_match(
            geometry_dimensions(saved), geometry_dimensions(actual)
        )
    ):
        return False
    desired_order = [matches[rows[index]["id"]] for index in saved_split[1]]
    occupant_order = [current[index]["address"] for index in actual_split[1]]
    if desired_order != occupant_order:
        return False
    return all(
        geometries_match(saved[saved_index][2:], actual[actual_index][2:])
        for saved_index, actual_index in zip(saved_split[1], actual_split[1])
    )


def restore_tiled_slots(
    rows, matches, clients, *, compositor=None, write_log=None
):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    rows_by_workspace = {}
    all_ok = True
    for row in rows:
        if not row.get("floating") and row.get("workspace_id") is not None:
            rows_by_workspace.setdefault(row["workspace_id"], []).append(row)

    for workspace_id, workspace_rows in rows_by_workspace.items():
        workspace_rows.sort(key=lambda row: row["ord"])

    resizable_workspaces = set()
    failed_workspaces = set()
    swapped_workspaces = set()
    for workspace_id, workspace_rows in rows_by_workspace.items():
        context = tiled_workspace_clients(
            workspace_id, workspace_rows, matches, clients
        )
        if context is None:
            continue
        current, _ = context
        if tiled_slot_addresses(workspace_rows, current) is not None:
            continue
        saved = [saved_geometry(row) for row in workspace_rows]
        current_geometry = [window_geometry(client) for client in current]
        saved_split = simple_split_order(saved)
        current_split = simple_split_order(current_geometry)
        if (
            saved_split is None
            or current_split is None
            or saved_split[0] != current_split[0]
            or not geometries_match(
                geometry_dimensions(saved), geometry_dimensions(current_geometry)
            )
        ):
            continue

        resizable_workspaces.add(workspace_id)
        desired_order = [
            matches[workspace_rows[index]["id"]] for index in saved_split[1]
        ]
        occupant_order = [current[index]["address"] for index in current_split[1]]
        if desired_order != occupant_order:
            result = compositor.apply(
                SwapWindows(address=desired_order[0], target=occupant_order[0])
            )
            if not result.succeeded:
                if result.status is MutationStatus.UNAVAILABLE:
                    write_log(
                        "restore: Hyprland IPC failed while arranging tiled windows"
                    )
                    return None
                all_ok = False
                failed_workspaces.add(workspace_id)
                continue
            swapped_workspaces.add(workspace_id)

    if swapped_workspaces:
        clients = observed(compositor, ObservationKind.WINDOWS)
        if clients is None:
            write_log("restore: Hyprland IPC failed after arranging tiled windows")
            return None

    resized = False
    for workspace_id in sorted(resizable_workspaces - failed_workspaces):
        workspace_rows = rows_by_workspace[workspace_id]
        context = tiled_workspace_clients(
            workspace_id, workspace_rows, matches, clients
        )
        if context is None:
            if workspace_id in swapped_workspaces:
                all_ok = False
                failed_workspaces.add(workspace_id)
            continue
        current, client_by_address = context
        saved = [saved_geometry(row) for row in workspace_rows]
        current_geometry = [window_geometry(client) for client in current]
        saved_split = simple_split_order(saved)
        current_split = simple_split_order(current_geometry)
        if (
            saved_split is None
            or current_split is None
            or saved_split[0] != current_split[0]
            or not geometries_match(
                geometry_dimensions(saved), geometry_dimensions(current_geometry)
            )
        ):
            if workspace_id in swapped_workspaces:
                all_ok = False
                failed_workspaces.add(workspace_id)
            continue
        if workspace_id in swapped_workspaces:
            desired_order = [
                matches[workspace_rows[index]["id"]] for index in saved_split[1]
            ]
            occupant_order = [current[index]["address"] for index in current_split[1]]
            if desired_order != occupant_order:
                all_ok = False
                failed_workspaces.add(workspace_id)
                continue

        if all(
            geometries_match(
                saved_geometry(row)[2:],
                window_geometry(client_by_address[matches[row["id"]]])[2:],
            )
            for row in workspace_rows
        ):
            continue
        candidates = []
        for row in workspace_rows:
            client = client_by_address[matches[row["id"]]]
            desired = saved_geometry(row)
            actual = window_geometry(client)
            if not geometries_match(desired[2:], actual[2:]):
                error = abs(desired[2] - actual[2]) + abs(
                    desired[3] - actual[3]
                )
                candidates.append((error, client, desired))
        _, client, desired = max(candidates, key=lambda candidate: candidate[0])
        result = compositor.apply(
            ResizeWindow(
                address=client["address"], width=desired[2], height=desired[3]
            )
        )
        if not result.succeeded:
            if result.status is MutationStatus.UNAVAILABLE:
                write_log(
                    "restore: Hyprland IPC failed while resizing tiled windows"
                )
                return None
            all_ok = False
            failed_workspaces.add(workspace_id)
            continue
        resized = True

    if resized:
        clients = observed(compositor, ObservationKind.WINDOWS)
        if clients is None:
            write_log("restore: Hyprland IPC failed after resizing tiled windows")
            return None

    for workspace_id, workspace_rows in rows_by_workspace.items():
        if workspace_id in failed_workspaces:
            continue
        context = tiled_workspace_clients(
            workspace_id, workspace_rows, matches, clients
        )
        if context is None:
            continue
        current, _ = context
        slot_addresses = tiled_slot_addresses(workspace_rows, current)
        if slot_addresses is None:
            if workspace_id in resizable_workspaces and not two_window_geometry_matches(
                workspace_rows, matches, current
            ):
                write_log(
                    f"restore: tiled geometry did not settle on workspace {workspace_id}"
                )
                all_ok = False
            continue

        for index, row in enumerate(workspace_rows):
            desired = matches[row["id"]]
            occupant = slot_addresses[index]
            if desired == occupant:
                continue
            other_index = slot_addresses.index(desired)
            result = compositor.apply(
                SwapWindows(address=desired, target=occupant)
            )
            if not result.succeeded:
                if result.status is MutationStatus.UNAVAILABLE:
                    write_log(
                        "restore: Hyprland IPC failed while correcting tiled slots"
                    )
                    return None
                all_ok = False
                break
            slot_addresses[index], slot_addresses[other_index] = (
                slot_addresses[other_index],
                slot_addresses[index],
            )
    return all_ok


def restore_tiled_layouts(
    rows,
    matches,
    clients,
    layouts,
    focus_context=None,
    *,
    compositor=None,
    write_log=None,
):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    nested_result = restore_nested_tiled_layouts(
        rows,
        matches,
        clients,
        layouts or {},
        focus_context,
        compositor=compositor,
        write_log=write_log,
    )
    if nested_result is None:
        return None
    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        write_log("restore: Hyprland IPC failed after replaying tiled layouts")
        return None
    slots_result = restore_tiled_slots(
        rows, matches, clients, compositor=compositor, write_log=write_log
    )
    if slots_result is None:
        return None
    return nested_result and slots_result


def restore_was_completed(sid):
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not instance:
        return False
    try:
        marker = json.loads(RESTORE_MARKER_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    return (
        marker.get("session") == sid
        and marker.get("instance") == instance
        and marker.get("complete") is True
    )


def restore_is_ready():
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not instance:
        return False
    try:
        marker = json.loads(RESTORE_MARKER_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    return marker.get("instance") == instance and marker.get("complete") is True


def mark_restore_completed(sid, complete=True):
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not instance:
        return False
    temporary = None
    try:
        secure_state_storage()
        with tempfile.NamedTemporaryFile("w", dir=STATE_DIR, delete=False) as handle:
            json.dump(
                {"session": sid, "instance": instance, "complete": complete}, handle
            )
            handle.flush()
            os.fsync(handle.fileno())
            temporary = Path(handle.name)
        os.replace(temporary, RESTORE_MARKER_PATH)
        return True
    except OSError as error:
        if temporary is not None:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass
        try:
            log(f"restore: failed to write completion marker: {error}")
        except OSError:
            pass
        return False


def read_current_session_name():
    try:
        marker = json.loads(CURRENT_SESSION_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(marker, dict):
        return None
    name = marker.get("name")
    return name if isinstance(name, str) else None


def write_current_session_name(name):
    temporary = None
    try:
        secure_state_storage()
        with tempfile.NamedTemporaryFile("w", dir=STATE_DIR, delete=False) as handle:
            json.dump({"name": name}, handle)
            handle.flush()
            os.fsync(handle.fileno())
            temporary = Path(handle.name)
        os.replace(temporary, CURRENT_SESSION_PATH)
        return True
    except OSError as error:
        if temporary is not None:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass
        try:
            log(f"current session: failed to write marker: {error}")
        except OSError:
            pass
        return False


def refresh_hyprland_instance():
    result = subprocess.run(
        ["systemctl", "--user", "show-environment"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        os.environ.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
        return False
    prefix = "HYPRLAND_INSTANCE_SIGNATURE="
    for line in result.stdout.splitlines():
        if line.startswith(prefix):
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = line.removeprefix(prefix)
            return True
    os.environ.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
    return False


def chromium_webapp_class_base(cls):
    match = re.fullmatch(
        r"(chrome-[A-Za-z0-9.-]+\.[A-Za-z]{2,}_.+)-(?:Default|Profile_[0-9]+)",
        cls or "",
    )
    return match.group(1) if match else None


def chromium_webapp_url(row):
    cls = row.get("initial_class") or row.get("class", "")
    class_base = chromium_webapp_class_base(cls)
    if class_base is None:
        return None

    candidates = []
    initial_title = row.get("initial_title") or ""
    match = re.fullmatch(r"([A-Za-z0-9.-]+\.[A-Za-z]{2,})_(/.*)", initial_title)
    if match:
        candidates.append(f"https://{match.group(1)}{match.group(2)}")
    try:
        argv = shlex.split(row.get("cmdline") or "")
        for index, argument in enumerate(argv):
            if argument.startswith("--app="):
                candidates.append(argument.removeprefix("--app="))
            elif argument == "--app" and index + 1 < len(argv):
                candidates.append(argv[index + 1])
    except ValueError:
        pass

    for candidate in candidates:
        match = re.fullmatch(r"https://([A-Za-z0-9.-]+\.[A-Za-z]{2,})(/.*)", candidate)
        if (
            match
            and class_base
            == f"chrome-{match.group(1)}_{match.group(2).replace('/', '_')}"
        ):
            return candidate
    return None


def process_groups(rows):
    groups = {}
    for row in rows:
        if chromium_webapp_url(row):
            key = ("webapp", row["id"])
        else:
            key = (
                ("pid", row["pid"])
                if row.get("pid") is not None
                else ("legacy", row["id"])
            )
        groups.setdefault(key, []).append(row)
    return sorted(groups.values(), key=lambda group: min(row["ord"] for row in group))


def process_launch_row(rows):
    return next(
        (row for row in rows if row.get("class") in CHROMIUM_NORMAL_CLASSES),
        rows[0],
    )


def normalized_cmdline(cmdline):
    try:
        argv = shlex.split(cmdline)
        if len(argv) == 1 and any(ch.isspace() for ch in argv[0]):
            nested_argv = shlex.split(argv[0])
            if nested_argv and Path(nested_argv[0]).exists():
                argv = nested_argv
        return shlex.join(argv)
    except ValueError:
        return cmdline


def launch_command(row):
    webapp_url = chromium_webapp_url(row)
    if webapp_url:
        return shlex.join(["omarchy-launch-webapp", webapp_url])
    command = normalized_cmdline(row["cmdline"])
    if row.get("class") in CHROMIUM_NORMAL_CLASSES:
        try:
            argv = shlex.split(command)
            filtered = []
            skip_next = False
            for argument in argv:
                if skip_next:
                    skip_next = False
                elif argument == "--app":
                    skip_next = True
                elif not argument.startswith("--app="):
                    filtered.append(argument)
            command = shlex.join(filtered)
        except ValueError:
            pass
    if row.get("class") == "org.gnome.Nautilus":
        try:
            argv = shlex.split(command)
            argv = [a for a in argv if a != "--gapplication-service"]
            command = shlex.join(argv)
        except ValueError:
            pass
    if row.get("cwd"):
        command = f"cd -- {shlex.quote(row['cwd'])} && {command}"
    return command


def launch_request(row):
    command = launch_command(row)
    rules = []
    if row.get("workspace_id") is not None:
        workspace = f"{row['workspace_id']} silent"
        rules.append(f"workspace = {lua_quote(workspace)}")
    if row.get("floating"):
        rules.append("float = true")
    rules_str = ", ".join(rules)
    action = LaunchApplication(
        command=command,
        workspace_id=row.get("workspace_id"),
        floating=bool(row.get("floating")),
    )
    return command, rules_str, action


def hyprland_supports_group_restore(*, compositor=None, write_log=None):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    version = observed(compositor, ObservationKind.VERSION)
    if version is None:
        return None
    match = re.match(r"^v?(\d+)\.(\d+)\.(\d+)", str(version.get("version", "")))
    if not match:
        write_log(
            "restore: cannot verify Hyprland group API version; skipping groups"
        )
        return False
    return tuple(map(int, match.groups())) >= (0, 56, 0)


def saved_window_groups(rows):
    grouped = {}
    for row in rows:
        if row.get("group_id") is not None:
            grouped.setdefault(row["group_id"], []).append(row)
    return sorted(
        grouped.values(), key=lambda group: min(row["ord"] for row in group)
    )


def restore_window_groups(
    rows,
    matches,
    failed_monitor_workspaces=(),
    *,
    compositor=None,
    write_log=None,
):
    compositor = compositor or ProductionHyprland()
    write_log = log if write_log is None else write_log
    eligible = []
    for group in saved_window_groups(rows):
        ordered = sorted(group, key=lambda row: row.get("group_ord", -1))
        if [row.get("group_ord") for row in ordered] != list(range(len(ordered))):
            write_log("restore: skipping group with invalid saved member order")
            continue
        if any(row["id"] not in matches for row in ordered):
            write_log("restore: skipping incomplete saved window group")
            continue
        if any(row.get("fullscreen") or row.get("pinned") for row in ordered):
            write_log("restore: skipping fullscreen or pinned window group")
            continue
        if any(
            row.get("workspace_id") in failed_monitor_workspaces for row in ordered
        ):
            write_log("restore: skipping group after failed monitor placement")
            continue
        if len({row.get("workspace_id") for row in ordered}) != 1 or len(
            {bool(row.get("floating")) for row in ordered}
        ) != 1:
            write_log("restore: skipping group with inconsistent saved placement")
            continue
        eligible.append(ordered)

    if not eligible:
        return True
    supported = hyprland_supports_group_restore(
        compositor=compositor, write_log=write_log
    )
    if supported is None:
        return None
    if not supported:
        write_log("restore: Hyprland 0.56+ is required to restore window groups")
        return True

    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        return None
    client_by_address = {
        client.get("address"): client
        for client in clients
        if client.get("mapped") and client.get("address")
    }
    expected_groups = []
    for group in eligible:
        addresses = [matches[row["id"]] for row in group]
        current = [client_by_address.get(address) for address in addresses]
        if any(client is None for client in current):
            write_log("restore: skipping group whose matched member disappeared")
            continue
        if any(
            (client.get("workspace") or {}).get("id") != row.get("workspace_id")
            for row, client in zip(group, current)
        ):
            write_log(
                "restore: skipping group whose members are not on their saved workspace"
            )
            continue
        if any(
            not client_match_is_unique(row, client, rows)
            or not row_match_is_unique(row, client, clients)
            for row, client in zip(group, current)
        ):
            write_log("restore: skipping group with ambiguous matched members")
            continue
        grouped = [client.get("grouped") for client in current]
        if all(tuple(value or ()) == tuple(addresses) for value in grouped):
            continue
        if any(value for value in grouped):
            write_log("restore: skipping group with conflicting current membership")
            continue

        mutation = compositor.apply(
            RestoreWindowGroup(addresses=addresses)
        )
        if mutation.status is MutationStatus.UNAVAILABLE:
            return None
        if not mutation.succeeded:
            return False
        expected_groups.append(addresses)

    if not expected_groups:
        return True
    clients = observed(compositor, ObservationKind.WINDOWS)
    if clients is None:
        return None
    client_by_address = {
        client.get("address"): client
        for client in clients
        if client.get("mapped") and client.get("address")
    }
    for addresses in expected_groups:
        if any(
            tuple(client_by_address.get(address, {}).get("grouped") or ())
            != tuple(addresses)
            for address in addresses
        ):
            write_log("restore: reconstructed window group failed verification")
            return False
    return True


def _production_restore_window_group(addresses):
    selectors = [lua_quote(f"address:{address}") for address in addresses]
    declarations = [
        f"local w{index}=assert(hl.get_window({selector}), 'group member missing')"
        for index, selector in enumerate(selectors, 1)
    ]
    ungrouped = " and ".join(
        f"w{index}.group == nil" for index in range(1, len(addresses) + 1)
    )
    operations = [
        *declarations,
        f"assert({ungrouped}, 'group member already grouped')",
        f"hl.dispatch(hl.dsp.group.toggle({{ window = {selectors[0]} }}))",
        "local g=assert(w1.group, 'group creation failed')",
        *(f"g:add(w{index}, g.size + 1)" for index in range(2, len(addresses) + 1)),
        *(
            [
                f"hl.dispatch(hl.dsp.group.active({{ index = 1, window = {selectors[0]} }}))"
            ]
            if len(addresses) > 1
            else []
        ),
        f"assert(g.size == {len(addresses)}, 'group size mismatch')",
        *(
            f"assert(g.members[{index}] == w{index}, 'group order mismatch')"
            for index in range(1, len(addresses) + 1)
        ),
    ]
    return " ".join(operations)


@dataclass(frozen=True)
class RestoreOutcome:
    restored_windows: int
    permanent_failures: int
    launched_processes: int
    retryable_failure: bool


@dataclass(frozen=True)
class RestorePreviewEntry:
    class_name: str
    command: str
    rules: str
    maximum_launches: int


@dataclass(frozen=True)
class RestorePreview:
    entries: tuple
    maximum_processes: int

    def __post_init__(self):
        object.__setattr__(self, "entries", tuple(self.entries))


class RestoreRun:
    """An immutable prepared restore plan that can execute once."""

    __slots__ = (
        "_clock",
        "_compositor",
        "_executed",
        "_initial_clients",
        "_initial_matches",
        "_launch_groups",
        "_preview",
        "_settings",
        "_sealed",
        "_snapshot",
        "_write_log",
    )

    def __init__(self, *_args, **_kwargs):
        raise TypeError("use RestoreRun.prepare()")

    def __setattr__(self, name, value):
        if getattr(self, "_sealed", False) and name != "_executed":
            raise AttributeError("a prepared Restore run is immutable")
        object.__setattr__(self, name, value)

    @classmethod
    def prepare(
        cls,
        snapshot,
        settings,
        *,
        compositor=None,
        clock=None,
        write_log=None,
    ):
        compositor = compositor or ProductionHyprland(write_log=write_log)
        initial_clients = observed(compositor, ObservationKind.WINDOWS)
        if initial_clients is None:
            return None
        initial_matches = MappingProxyType(
            match_windows(snapshot.windows, initial_clients, max_rank=2)
        )
        launch_groups = tuple(tuple(group) for group in process_groups(snapshot.windows))
        entries = []
        maximum_processes = 0
        for group in launch_groups:
            missing = [row for row in group if row["id"] not in initial_matches]
            if not missing:
                continue
            command, rules, _ = launch_request(process_launch_row(group))
            entries.append(
                RestorePreviewEntry(
                    group[0]["class"], command, rules, len(missing)
                )
            )
            maximum_processes += len(missing)

        self = object.__new__(cls)
        self._snapshot = snapshot
        self._settings = settings
        self._initial_matches = initial_matches
        self._initial_clients = tuple(initial_clients)
        self._launch_groups = launch_groups
        self._preview = RestorePreview(tuple(entries), maximum_processes)
        self._compositor = compositor
        self._clock = clock or SystemClockAdapter()
        self._write_log = log if write_log is None else write_log
        self._executed = False
        self._sealed = True
        return self

    def preview(self):
        return self._preview

    def execute(self):
        if self._executed:
            raise RuntimeError("a prepared Restore run can execute only once")
        self._executed = True
        with self._compositor.mutations():
            restored, failures, launched_processes, retryable_failure = self._execute_once()
        return RestoreOutcome(
            restored_windows=restored,
            permanent_failures=failures,
            launched_processes=launched_processes,
            retryable_failure=retryable_failure,
        )

    def _execute_once(self):
        rows = self._snapshot.windows
        initial_matches = self._initial_matches
        initial_clients = self._initial_clients
        layouts = self._snapshot.workspace_layouts
        restore_timeout = self._settings.timeout_seconds
        monitor_fallback = self._settings.monitor_fallback
        compositor = self._compositor
        clock = self._clock
        write_log = self._write_log
        row_by_id = {row["id"]: row for row in rows}
        matches = dict(initial_matches)
        used_addresses = {
            client.get("address")
            for client in initial_clients
            if client.get("mapped") and client.get("address")
        }
        restored = 0
        failures = 0
        launched_processes = 0
        handled = set()
        placed = set()
        client_by_address = {
            client.get("address"): client
            for client in initial_clients
            if client.get("address")
        }
        monitor_targets, current_monitors, monitor_ipc_failed = (
            load_workspace_monitor_context(
                rows,
                monitor_fallback,
                compositor=compositor,
                write_log=write_log,
            )
        )
        if monitor_ipc_failed:
            return restored, len(rows), launched_processes, True
        prepared_workspaces = set()
        failed_monitor_workspaces = set()

        for row_id, address in matches.items():
            row = row_by_id[row_id]
            workspace_id = row.get("workspace_id")
            target = monitor_targets.get(workspace_id)
            monitor_will_move = (
                target is not None
                and workspace_id not in prepared_workspaces
                and current_monitors.get(workspace_id) != target
            )
            monitor_result = prepare_workspace_monitor(
                row,
                address,
                monitor_targets,
                current_monitors,
                prepared_workspaces,
                compositor=compositor,
            )
            if monitor_result.status is MutationStatus.UNAVAILABLE:
                return restored, failures, launched_processes, True
            monitor_ok = monitor_result.succeeded
            if not monitor_ok:
                failed_monitor_workspaces.add(workspace_id)
            elif monitor_will_move:
                client_by_address = {
                    client.get("address"): client
                    for client in monitor_result.refreshed_windows
                    if client.get("address")
                }
            placement = (
                place_window(
                    row,
                    address,
                    client_by_address.get(address),
                    compositor=compositor,
                )
                if monitor_ok
                else MutationResult(MutationStatus.REJECTED)
            )
            if placement.status is MutationStatus.UNAVAILABLE:
                return restored, failures, launched_processes, True
            if placement.succeeded:
                restored += 1
                placed.add(row_id)
            else:
                failures += 1
            handled.add(row_id)

        states = []
        for group in self._launch_groups:
            missing = [row for row in group if row["id"] not in matches]
            if not missing:
                continue
            launch_row = process_launch_row(group)
            state = {
                "rows": group,
                "attempts": 0,
                "max_attempts": len(missing),
                "next_retry": clock.monotonic(),
                "launch_row": launch_row,
            }
            states.append(state)

            # A partially restored process may still be creating its other windows.
            if any(row["id"] in matches for row in group):
                state["next_retry"] = clock.monotonic() + RESTORE_RETRY_DELAY
                continue
            _, _, action = launch_request(launch_row)
            launch = compositor.apply(action)
            if launch.succeeded:
                state["attempts"] = 1
                state["next_retry"] = clock.monotonic() + RESTORE_RETRY_DELAY
                launched_processes += 1
            elif launch.status is MutationStatus.UNAVAILABLE:
                return restored, failures + len(rows) - len(handled), launched_processes, True
            else:
                state["attempts"] = state["max_attempts"]

        deadline = clock.monotonic() + restore_timeout
        while len(handled) < len(rows) and clock.monotonic() < deadline:
            clients = observed(compositor, ObservationKind.WINDOWS)
            if clients is None:
                write_log("restore: Hyprland IPC failed while waiting for windows")
                return (
                    restored,
                    failures + len(rows) - len(handled),
                    launched_processes,
                    True,
                )

            pending = [row for row in rows if row["id"] not in handled]
            found = match_windows(pending, clients, used_addresses, max_rank=3)
            client_by_address = {
                client.get("address"): client for client in clients if client.get("address")
            }
            for row_id, address in found.items():
                matches[row_id] = address
                used_addresses.add(address)
                row = row_by_id[row_id]
                workspace_id = row.get("workspace_id")
                target = monitor_targets.get(workspace_id)
                monitor_will_move = (
                    target is not None
                    and workspace_id not in prepared_workspaces
                    and current_monitors.get(workspace_id) != target
                )
                monitor_result = prepare_workspace_monitor(
                    row,
                    address,
                    monitor_targets,
                    current_monitors,
                    prepared_workspaces,
                    compositor=compositor,
                )
                if monitor_result.status is MutationStatus.UNAVAILABLE:
                    return restored, failures, launched_processes, True
                monitor_ok = monitor_result.succeeded
                if not monitor_ok:
                    failed_monitor_workspaces.add(workspace_id)
                elif monitor_will_move:
                    clients = monitor_result.refreshed_windows
                    client_by_address = {
                        client.get("address"): client
                        for client in clients
                        if client.get("address")
                    }
                placement = (
                    place_window(
                        row,
                        address,
                        client_by_address.get(address),
                        compositor=compositor,
                    )
                    if monitor_ok
                    else MutationResult(MutationStatus.REJECTED)
                )
                if placement.status is MutationStatus.UNAVAILABLE:
                    return restored, failures, launched_processes, True
                if placement.succeeded:
                    restored += 1
                    placed.add(row_id)
                else:
                    failures += 1
                handled.add(row_id)

            # A complete workspace can be corrected while unrelated applications
            # are still starting, rather than waiting for the restore-wide deadline.
            if found and len(handled) < len(rows) and any(
                not row.get("floating") and saved_geometry(row) is not None
                for row in rows
            ):
                tiled_result = restore_tiled_layouts(
                    rows,
                    matches,
                    clients,
                    layouts or {},
                    compositor=compositor,
                    write_log=write_log,
                )
                if tiled_result is None:
                    write_log(
                        "restore: Hyprland IPC failed while replaying tiled layouts"
                    )
                    return restored, failures, launched_processes, True
                if not tiled_result:
                    failures += 1

            now = clock.monotonic()
            for state in states:
                missing = [row for row in state["rows"] if row["id"] not in handled]
                if (
                    missing
                    and state["attempts"] < state["max_attempts"]
                    and now >= state["next_retry"]
                ):
                    _, _, action = launch_request(state["launch_row"])
                    launch = compositor.apply(action)
                    if launch.succeeded:
                        launched_processes += 1
                        state["attempts"] += 1
                        state["next_retry"] = now + RESTORE_RETRY_DELAY
                    elif launch.status is MutationStatus.UNAVAILABLE:
                        return (
                            restored,
                            failures + len(rows) - len(handled),
                            launched_processes,
                            True,
                        )
                    else:
                        state["attempts"] = state["max_attempts"]

            if len(handled) < len(rows):
                clock.sleep(RESTORE_POLL_INTERVAL)

        for row in rows:
            if row["id"] not in handled:
                failures += 1
                write_log(f"restore: no window appeared for {row['class']}")
        focus_context = load_focus_context(compositor=compositor)
        retryable_failure = focus_context is None
        if focus_context is None:
            write_log(
                "restore: Hyprland IPC failed while recording focus; "
                "tiled/group correction will still run"
            )
        if any(not row.get("floating") and saved_geometry(row) is not None for row in rows):
            clients = observed(compositor, ObservationKind.WINDOWS)
            if clients is None:
                write_log("restore: Hyprland IPC failed while correcting tiled slots")
                return restored, failures, launched_processes, True
            tiled_matches = {
                row_id: address
                for row_id, address in matches.items()
                if row_by_id[row_id].get("workspace_id") not in failed_monitor_workspaces
            }
            tiled_result = restore_tiled_layouts(
                rows,
                tiled_matches,
                clients,
                layouts or {},
                focus_context,
                compositor=compositor,
                write_log=write_log,
            )
            if tiled_result is None:
                write_log("restore: Hyprland IPC failed while replaying tiled layouts")
                return restored, failures, launched_processes, True
            if not tiled_result:
                failures += 1
        floating_result = verify_floating_placements(
            rows,
            {row_id: matches[row_id] for row_id in placed},
            compositor=compositor,
            clock=clock,
            write_log=write_log,
        )
        if floating_result is None:
            write_log("restore: Hyprland IPC failed while verifying floating geometry")
            return restored, failures, launched_processes, True
        if not floating_result:
            failures += 1
        group_result = restore_window_groups(
            rows,
            matches,
            failed_monitor_workspaces,
            compositor=compositor,
            write_log=write_log,
        )
        if group_result is None:
            write_log("restore: Hyprland IPC failed while restoring window groups")
            return restored, failures, launched_processes, True
        if not group_result:
            failures += 1
        if focus_context is not None:
            focus_result = restore_focus_context(
                focus_context, compositor=compositor
            )
            if focus_result is None:
                write_log("restore: Hyprland IPC failed while restoring focus")
                return restored, failures, launched_processes, True
            if not focus_result:
                write_log("restore: failed to restore the previously focused workspace")
                failures += 1
        return restored, failures, launched_processes, retryable_failure


def cmd_restore(dry_run=False, name=None):
    if name is not None:
        session_name(name)
    cfg = load_config()
    lock_file = acquire_operation_lock()
    if lock_file is None:
        print("restore deferred: another session operation is running")
        return 75
    try:
        try:
            snapshot = SnapshotHistory().select(name=name)
        except SnapshotHistoryError as error:
            print(f"snapshot history error: {error}", file=sys.stderr)
            return 75 if error.retryable else 1
        if snapshot is None:
            if name is not None:
                print(f"no saved session named {name!r}", file=sys.stderr)
                return 1
            print("no saved session to restore")
            if (
                not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
                or observed(ProductionHyprland(), ObservationKind.WINDOWS) is None
            ):
                print("restore deferred: Hyprland IPC is unavailable", file=sys.stderr)
                return 75
            return 0 if dry_run or mark_restore_completed(None) else 75
        sid = snapshot.session_id
        if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            print("restore failed: Hyprland IPC is unavailable", file=sys.stderr)
            return 75
        prepared = RestoreRun.prepare(
            snapshot,
            RestoreSettings(
                timeout_seconds=cfg["restore_timeout_seconds"],
                monitor_fallback=cfg["monitor_fallback"],
            ),
        )
        if prepared is None:
            print("restore failed: Hyprland IPC is unavailable", file=sys.stderr)
            return 75
        if name is None and restore_was_completed(sid):
            print(
                "restore skipped: named session already handled for this desktop"
                if name is not None
                else "restore skipped: session already handled for this desktop"
            )
            return 0
        rows = snapshot.windows
        if not rows:
            print("saved session is empty; nothing to restore")
            if dry_run:
                return 0
            if not mark_restore_completed(sid):
                return 75
            write_current_session_name(name)
            return 0
        if dry_run:
            preview = prepared.preview()
            for entry in preview.entries:
                print(
                    f"[dry-run] {entry.class_name}: {entry.command}  "
                    f"rules={{ {entry.rules} }}  launches<= {entry.maximum_launches}"
                )
            print(
                f"would launch up to {preview.maximum_processes} processes for {len(rows)} windows"
            )
            return 0

        if not mark_restore_completed(sid, complete=False):
            print("restore deferred: could not persist restore state", file=sys.stderr)
            return 75

        outcome = prepared.execute()
        print(f"restored {outcome.restored_windows}/{len(rows)} windows")
        log(
            f"restore: restored {outcome.restored_windows}/{len(rows)} windows from "
            f"{outcome.launched_processes} launched processes"
            + (f" (named session {name!r})" if name is not None else "")
        )
        if outcome.retryable_failure:
            return 75
        if outcome.permanent_failures:
            return 1
        if not mark_restore_completed(sid):
            return 75
        write_current_session_name(name)
        return 0
    finally:
        lock_file.close()


def cmd_autosave(interval=None):
    cfg = load_config_or_defaults("autosave")
    interval = interval or cfg.get("autosave_seconds", 60)
    while True:
        time.sleep(interval)
        refresh_hyprland_instance()
        if not restore_is_ready():
            log("autosave: waiting for startup restore to complete")
            continue
        try:
            cmd_save("periodic")
        except Exception as e:  # noqa: BLE001 - keep the long-running daemon alive
            log(f"autosave error: {e}")


def cmd_status():
    for snapshot in SnapshotHistory().recent():
        print(
            f"session {snapshot.session_id} [{snapshot.label}] {snapshot.created_at}: "
            f"{snapshot.window_count} windows ({snapshot.capture_status})"
        )


def cmd_list(as_json=False):
    sessions = [
        {
            "name": snapshot.name,
            "id": snapshot.session_id,
            "created_at": snapshot.created_at,
            "windows": snapshot.window_count,
        }
        for snapshot in SnapshotHistory().list_named()
    ]
    if as_json:
        print(json.dumps(sessions, ensure_ascii=False))
    else:
        for session in sessions:
            print(
                f"{session['name']}: session {session['id']}, "
                f"{session['created_at']}, {session['windows']} windows"
            )
    return 0


def cmd_delete(name):
    session_name(name)
    lock_file = acquire_operation_lock()
    if lock_file is None:
        print("delete deferred: another session operation is running")
        return 75
    try:
        deleted = SnapshotHistory().delete_named(name)
        if deleted is None:
            print(f"no saved session named {name!r}", file=sys.stderr)
            return 1
        if read_current_session_name() == name:
            write_current_session_name(None)
        log(
            f"delete: removed named session {name!r} "
            f"(session {deleted.session_id})"
        )
        print(f"deleted named session {name!r}")
        return 0
    finally:
        lock_file.close()


def acceptance_result(ok, message):
    print(f"{'PASS' if ok else 'FAIL'}: {message}")
    return ok


def acceptance_session(marker):
    try:
        snapshot = SnapshotHistory(read_only=True).select(session_id=marker["session"])
    except (KeyError, SnapshotHistoryError):
        return None, []
    if snapshot is None:
        return None, []
    return (snapshot.label, snapshot.capture_status), snapshot.windows


def systemd_unit_active(unit):
    result = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit], check=False
    )
    return result.returncode == 0


def systemd_unit_failed(unit):
    result = subprocess.run(
        ["systemctl", "--user", "is-failed", "--quiet", unit], check=False
    )
    return result.returncode == 0


def cmd_acceptance(expect_power_save=False, expect_restore_failure=False):
    """Report live reboot evidence; startup may maintain state permissions/schema."""
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    restore_ok = (
        systemd_unit_failed("omarchy-sesh.service")
        if expect_restore_failure
        else systemd_unit_active("omarchy-sesh.service")
    )
    autosave_enabled = subprocess.run(
        ["systemctl", "--user", "is-enabled", "--quiet", AUTOSAVE_UNIT], check=False
    ).returncode == 0
    autosave_active = systemd_unit_active(AUTOSAVE_UNIT)
    checks = [
        acceptance_result(bool(instance), "Hyprland instance is available"),
        acceptance_result(restore_ok,
                          "restore service " + ("failed as expected" if expect_restore_failure else "is active")),
        acceptance_result(not autosave_enabled or autosave_active,
                          "autosave service state matches its mode"),
    ]
    try:
        marker = json.loads(RESTORE_MARKER_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        marker = {}
    marker_complete = marker.get("complete") is True and marker.get("instance") == instance
    checks.append(
        acceptance_result(marker_complete != expect_restore_failure,
                          "restore marker " + ("is incomplete as expected" if expect_restore_failure else "matches this compositor"))
    )
    session, rows = acceptance_session(marker)
    session_complete = bool(session and session[1] == "complete")
    checks.append(acceptance_result(session_complete, "restore source is a complete snapshot"))
    if expect_power_save:
        checks.append(
            acceptance_result(bool(session and session[0] == "logout"),
                              "restore source was saved by a power-menu action")
        )
    if expect_restore_failure or not session_complete:
        return 0 if all(checks) else 1
    clients = observed(ProductionHyprland(), ObservationKind.WINDOWS)
    matches = match_windows(rows, clients or []) if clients is not None else {}
    checks.append(acceptance_result(clients is not None, "Hyprland clients are readable"))
    checks.append(
        acceptance_result(len(matches) == len(rows),
                          f"matched {len(matches)}/{len(rows)} saved windows")
    )
    return 0 if all(checks) else 1


def cmd_mode(mode=None, as_json=False):
    if mode is None:
        result = subprocess.run(
            ["systemctl", "--user", "is-enabled", AUTOSAVE_UNIT],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            if as_json:
                print(json.dumps({"mode": "active", "name": read_current_session_name()}))
            else:
                print("active")
            state = subprocess.run(
                ["systemctl", "--user", "is-active", AUTOSAVE_UNIT],
                capture_output=True,
                text=True,
                check=False,
            )
            if state.returncode != 0:
                print(
                    f"warning: {AUTOSAVE_UNIT} is enabled but "
                    f"{state.stdout.strip() or 'not running'}; "
                    "periodic saves are not happening",
                    file=sys.stderr,
                )
            return 0
        if result.stdout.strip() == "disabled":
            if as_json:
                print(json.dumps({"mode": "manual", "name": read_current_session_name()}))
            else:
                print("manual")
            return 0
        print(
            result.stderr.strip() or "autosave service is not installed",
            file=sys.stderr,
        )
        return result.returncode or 1

    if mode == "active" and not restore_is_ready():
        if as_json:
            with contextlib.redirect_stdout(io.StringIO()):
                result = cmd_save("manual", wait=True)
        else:
            result = cmd_save("manual", wait=True)
        if result != 0:
            print(
                "failed to capture the current session before enabling autosave",
                file=sys.stderr,
            )
            return result
        if not restore_is_ready():
            print("failed to establish the current Hyprland session", file=sys.stderr)
            return 1

    action = "enable" if mode == "active" else "disable"
    result = subprocess.run(
        ["systemctl", "--user", action, "--now", AUTOSAVE_UNIT],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(result.stderr.strip() or f"failed to set {mode} mode", file=sys.stderr)
        return result.returncode
    if as_json:
        print(json.dumps({"mode": mode, "name": read_current_session_name()}))
    else:
        print(mode)
    return 0


def main():
    os.umask(0o077)
    try:
        secure_state_storage()
        migrate_empty_xdg_paths()
    except OSError as error:
        print(f"state storage error: {error}", file=sys.stderr)
        return 1
    parser = argparse.ArgumentParser(prog="omarchy-sesh")
    sub = parser.add_subparsers(dest="command")

    p_save = sub.add_parser("save", help="snapshot current windows")
    p_save.add_argument("--label", default="manual")
    p_save.add_argument("--name", type=argparse_session_name)
    p_save.add_argument("--teardown", action="store_true")
    p_save.add_argument("--wait", action="store_true")

    p_restore = sub.add_parser("restore", help="restore latest snapshot")
    p_restore.add_argument("--dry-run", action="store_true")
    p_restore.add_argument("--name", type=argparse_session_name)

    p_auto = sub.add_parser("autosave", help="periodically save")
    p_auto.add_argument("--interval", type=int, default=None)

    sub.add_parser("status", help="list saved sessions")

    p_list = sub.add_parser("list", help="list named sessions")
    p_list.add_argument("--json", action="store_true", help="emit JSON")

    p_delete = sub.add_parser("delete", help="delete a named session")
    p_delete.add_argument("--name", required=True, type=argparse_session_name)

    p_acceptance = sub.add_parser(
        "acceptance", help="report evidence for a live reboot acceptance run"
    )
    p_acceptance.add_argument("--expect-power-save", action="store_true")
    p_acceptance.add_argument("--expect-restore-failure", action="store_true")

    p_mode = sub.add_parser("mode", help="get or set autosave mode")
    p_mode.add_argument("mode", nargs="?", choices=("active", "manual"))
    p_mode.add_argument("--json", action="store_true", help="emit JSON for the query form")

    args = parser.parse_args()
    try:
        if args.command == "save":
            return cmd_save(
                args.label, teardown=args.teardown, wait=args.wait, name=args.name
            )
        if args.command == "restore":
            return cmd_restore(dry_run=args.dry_run, name=args.name)
        if args.command == "autosave":
            return cmd_autosave(args.interval)
        if args.command == "status":
            return cmd_status()
        if args.command == "list":
            return cmd_list(as_json=args.json)
        if args.command == "delete":
            return cmd_delete(args.name)
        if args.command == "acceptance":
            return cmd_acceptance(
                expect_power_save=args.expect_power_save,
                expect_restore_failure=args.expect_restore_failure,
            )
        if args.command == "mode":
            return cmd_mode(args.mode, as_json=args.json)
    except ConfigError as e:
        print(f"configuration error: {e}", file=sys.stderr)
        return 2
    except SnapshotHistoryError as e:
        print(f"snapshot history error: {e}", file=sys.stderr)
        return 75 if e.retryable else 1
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
